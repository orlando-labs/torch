#!/bin/sh
set -eu
export PYTORCH_ENABLE_MPS_FALLBACK=0
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
mkdir -p build/logs
build_test() {
  ./tools/build --no-notebook "$@"
}
cmake -P tests/notebook_bundle.cmake
run_without_python() {
  executable=$1
  dylib_log=$2
  shift 2
  if ! DYLD_PRINT_LIBRARIES=1 PATH=/nonexistent "$executable" "$@" 2>"$dylib_log"; then
    tail -80 "$dylib_log" >&2
    exit 1
  fi
  if /usr/bin/grep -E 'libpython[0-9.]|/Python.framework/|libtorch_python' "$dylib_log"; then
    echo 'FAIL an executable loaded a Python runtime library' >&2
    exit 1
  fi
}
build_test tests/cpu.s --probes >build/logs/build-cpu.log 2>&1
./build/native/torch_probe cpu
./build/native/torch_checkpoint_fixtures build/fixtures
run_without_python ./build/sputnik/torch.cpu_test build/logs/cpu-dylibs.log
build_test tests/cpu.s --run-vm >build/logs/vm-cpu.log 2>&1
cat build/logs/vm-cpu.log
build_test tests/modular_imports.s --run-vm >build/logs/vm-modules.log 2>&1
cat build/logs/vm-modules.log
build_test tests/direct_tensor_import.s --run-vm >build/logs/vm-direct-import.log 2>&1
cat build/logs/vm-direct-import.log
for module_test in idioms auto_registration nn_catalog nn_families normalization spatial losses embeddings recurrent attention packed training data_loader materialization numerical indexing; do
  build_test "tests/$module_test.s" --run-vm >"build/logs/vm-$module_test.log" 2>&1
  cat "build/logs/vm-$module_test.log"
  build_test "tests/$module_test.s" >"build/logs/build-$module_test.log" 2>&1
  PATH=/nonexistent "./build/sputnik/torch.${module_test}_test"
done
build_test tests/serialization.s >build/logs/build-serialization.log 2>&1
PATH=/nonexistent ./build/sputnik/torch.serialization_test
./build/native/torch_checkpoint_fixtures verify build/fixtures/sputnik.pt
build_test tests/distributed.s >build/logs/build-distributed.log 2>&1
./build/native/torch-run --nproc 2 --timeout 60 ./build/sputnik/torch.distributed_test
build_test tests/distributed_errors.s >build/logs/build-distributed-errors.log 2>&1
./build/native/torch-run --nproc 2 --timeout 30 ./build/sputnik/torch.distributed_errors_test
build_test tests/distributed_errors.s --run-vm >build/logs/vm-distributed-errors-bootstrap.log 2>&1 && {
  echo 'FAIL distributed initialization without launcher must fail' >&2; exit 1
}
/usr/bin/grep -q 'missing launcher variable: RANK' build/logs/vm-distributed-errors-bootstrap.log
./build/native/torch-run --nproc 2 --timeout 30 "${SPUTNIK_ROOT:-../sputnik-lang}/build/sputnik" run "$root/build/torch.distributed_errors_test.build.json" --grant ffi
if ./build/native/torch-run --nproc 2 /usr/bin/false; then
  echo 'FAIL launcher must propagate worker failure' >&2; exit 1
fi
if ./build/native/torch-run --nproc 2 --timeout 1 /bin/sleep 10; then
  echo 'FAIL launcher must enforce timeout' >&2; exit 1
fi
if [ "${1:-}" = --mps ]; then
  PATH=/nonexistent ./build/sputnik/torch.materialization_test --device mps
  run_without_python ./build/sputnik/torch.embeddings_test build/logs/embeddings-mps-dylibs.log --device mps
  run_without_python ./build/sputnik/torch.recurrent_test build/logs/recurrent-mps-dylibs.log --device mps
  run_without_python ./build/sputnik/torch.attention_test build/logs/attention-mps-dylibs.log --device mps
  run_without_python ./build/sputnik/torch.packed_test build/logs/packed-mps-dylibs.log --device mps
  build_test tests/mps.s >build/logs/build-mps.log 2>&1
  ./build/native/torch_probe mps
  PATH=/nonexistent ./build/sputnik/torch.mps_test
  for module_test in nn normalization spatial losses training numerical indexing; do
    build_test "tests/${module_test}_mps.s" >"build/logs/build-$module_test-mps.log" 2>&1
    PATH=/nonexistent "./build/sputnik/torch.${module_test}_mps_test"
  done
  build_test examples/showcase.s >build/logs/build-showcase.log 2>&1
  if [ -f build/datasets/mnist/train-images-idx3-ubyte ]; then
    run_without_python ./build/sputnik/torch.showcase build/logs/showcase-dylibs.log \
      --epochs 1 --train-limit 256 --test-limit 128 --batch-size 64 \
      --checkpoint build/mnist-suite-smoke.pt
  else
    echo 'MNIST runtime smoke skipped: run ./tools/fetch-mnist to supply the dataset'
  fi
fi
printf '%s\n' 'PASS torch test suite'
