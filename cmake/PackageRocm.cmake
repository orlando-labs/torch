cmake_minimum_required(VERSION 3.27)
include("${ROOT}/cmake/BuildJson.cmake")
include("${ROOT}/cmake/PackageManifest.cmake")
include("${ROOT}/cmake/PackageScope.cmake")
include("${ROOT}/cmake/TorchProvider.cmake")
include("${ROOT}/cmake/ValidateComponents.cmake")
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
execute_process(COMMAND uname -m OUTPUT_VARIABLE host_arch OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT host_arch STREQUAL "x86_64")
  message(FATAL_ERROR "The registry ROCm recipe requires Linux x86_64")
endif()
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${TORCH_PREFIX}" TORCH_PREFIX)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
torch_provider("${TORCH_PREFIX}")
if(NOT TORCH_PROVIDER_BACKEND STREQUAL "rocm" OR NOT TORCH_PROVIDER_VERSION STREQUAL "2.14.0")
  message(FATAL_ERROR "The registry recipe is verified with LibTorch 2.14.0 ROCm")
endif()
file(READ "/opt/rocm/.info/version" rocm_version)
if(NOT rocm_version MATCHES "^6[.]4[.]3")
  message(FATAL_ERROR "The registry recipe requires the verified ROCm 6.4.3 userspace")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(LOCK "${OUTPUT}/package.lock" GUARD PROCESS TIMEOUT 0)
set(options)
if(DEFINED ENV{SPUTNIK_NATIVE_CXX} AND NOT "$ENV{SPUTNIK_NATIVE_CXX}" STREQUAL "")
  list(APPEND options "-DCMAKE_CXX_COMPILER=$ENV{SPUTNIK_NATIVE_CXX}")
endif()
set(build "${ROOT}/build/package-rocm")
set(gloo "${ROOT}/build/deps/gloo-74cc005ae13f69c11d8a41e50b42025b6730e796")
run(cmake -S "${ROOT}" -B "${build}" -G Ninja "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}"
  "-DSPUTNIKTORCH_PREBUILT_TORCH_ROOT=${TORCH_PREFIX}" "-DGLOO_INCLUDE_DIR=${gloo}"
  "-DSPUTNIKTORCH_ERROR_NAMESPACE=${error_namespace}" ${options} -DCMAKE_BUILD_TYPE=Release)
run(cmake --build "${build}" --target torch_package torch_probe -j 6)
run("${build}/torch_probe" cuda:0)
set(stage "${OUTPUT}/stage-rocm")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/lib/vendor" "${stage}/meta" "${stage}/licenses")
file(COPY "${ROOT}/src" DESTINATION "${stage}")
scope_package_sources("${stage}")
package_inventory(module_files module_names "${stage}")
file(COPY_FILE "${build}/libtorch_package.so" "${stage}/lib/libtorch_package.so")
# Preserve SONAMEs and remove producer paths. ROCm userspace is a system
# dependency; LibTorch and its matching RCCL are carried by this artifact.
file(GLOB libraries "${TORCH_PREFIX}/lib/*.so" "${TORCH_PREFIX}/lib/*.so.*")
list(APPEND libraries "/opt/rccl-2.27.7/lib/librccl.so.1")
list(SORT libraries)
set(runtime_files)
set(runtime_libraries "[]")
set(abi "libtorch-2.14.0-cxx11-linux-x86_64-gnu-rocm6.4.3")
set(material "${abi}\n")
foreach(library IN LISTS libraries)
  get_filename_component(name "${library}" NAME)
  if(name MATCHES "python|test|backend_with_compiler")
    continue()
  endif()
  set(path "lib/vendor/${name}")
  file(COPY_FILE "${library}" "${stage}/${path}")
  run(patchelf --force-rpath --set-rpath "$ORIGIN" "${stage}/${path}")
  file(SHA256 "${stage}/${path}" hash)
  string(APPEND material "${name}=${hash}\n")
  list(APPEND runtime_files "${path}")
  string(JSON count LENGTH "${runtime_libraries}")
  string(JSON runtime_libraries SET "${runtime_libraries}" ${count} "{\"path\":\"${path}\",\"role\":\"dependency\",\"abi\":\"${abi}\"}")
endforeach()
string(SHA256 build_hash "${material}")
set(build_id "sha256:${build_hash}")
file(DOWNLOAD "https://raw.githubusercontent.com/pytorch/pytorch/2b3ec34829036a65cd9d1398ea72a0167dc37470/LICENSE" "${stage}/licenses/PyTorch-LICENSE.txt" TLS_VERIFY ON STATUS license_status)
list(GET license_status 0 license_code)
if(NOT license_code EQUAL 0)
  message(FATAL_ERROR "Cannot retain upstream LibTorch license")
endif()
file(DOWNLOAD "https://raw.githubusercontent.com/ROCm/rccl/rocm-6.4.3/LICENSE.txt" "${stage}/licenses/RCCL-LICENSE.txt" TLS_VERIFY ON STATUS license_status)
list(GET license_status 0 license_code)
if(NOT license_code EQUAL 0)
  message(FATAL_ERROR "Cannot retain upstream RCCL license")
endif()
file(COPY_FILE "${gloo}/LICENSE" "${stage}/licenses/Gloo-LICENSE.txt")
file(WRITE "${stage}/README.md" "Torch ${PACKAGE_VERSION}: LibTorch 2.14.0 C++ runtime and RCCL 2.27.7 for Linux x86_64, glibc 2.34 and ROCm 6.4.3. ROCm userspace and the AMD kernel driver are system dependencies. Verified on three gfx906 GPUs; gfx906 rocBLAS Tensile data must be installed and selected with ROCBLAS_TENSILE_LIBPATH when absent from the system ROCm distribution. No Python runtime or compiler is needed to install or execute VM code. Select this ROCm variant or use --backend rocm.\n")
file(WRITE "${stage}/meta/requirements.json" "{\"schema\":\"torch.requirements.v1\",\"libtorch_version\":\"2.14.0\",\"rocm_version\":\"6.4.3\",\"rccl_version\":\"2.27.7\",\"verified_gpu_architectures\":[\"gfx906\"],\"build_id\":\"${build_id}\",\"system_dependencies\":[\"ROCm 6.4.3 userspace\",\"AMD kernel driver\",\"rocBLAS gfx906 Tensile kernels\"]}\n")
json_array(runtime_json ${runtime_files})
file(WRITE "${stage}/meta/components.json" "{\"schema\":\"sputnik.native-components.v1\",\"components\":[{\"name\":\"LibTorch ROCm C++ runtime and RCCL\",\"version\":\"2.14.0 / 2.27.7\",\"license\":\"upstream component terms retained in materials\",\"origin\":\"LibTorch 2.14.0 C++ build for ROCm 6.4.3; ROCm RCCL 2.27.7\",\"files\":${runtime_json},\"materials\":[\"licenses/PyTorch-LICENSE.txt\",\"licenses/Gloo-LICENSE.txt\",\"licenses/RCCL-LICENSE.txt\"]}]}\n")
validate_components("${stage}" "meta/components.json")
set(variant "linux-x86_64-gnu-rocm643-prebuilt-source-runtime")
set(runtime "{\"id\":\"libtorch\",\"kind\":\"runtime\",\"version\":\"2.14.0\",\"abi\":\"${abi}\",\"build_id\":\"${build_id}\",\"library_dirs\":[\"lib/vendor\"],\"link_libraries\":[\"torch\",\"torch_cpu\",\"c10\",\"torch_hip\",\"c10_hip\"],\"libraries\":${runtime_libraries}}")
set(requirement "{\"id\":\"libtorch\",\"kind\":\"runtime\",\"version\":\"2.14.0\",\"abi\":\"${abi}\",\"build_id\":\"${build_id}\",\"provider\":\"bundled\"}")
set(manifest "{\"name\":\"${PACKAGE_REF}\",\"version\":\"${PACKAGE_VERSION}\",\"source_root\":\"src\",\"module_names\":${module_names},\"files\":${module_files},\"artifact\":{\"variant\":\"${variant}\",\"bundle\":\"runtime\",\"limit_profile\":\"native-large\"},\"target\":{\"os\":\"linux\",\"arch\":\"x86_64\",\"libc\":\"gnu\",\"min_libc\":\"2.34\",\"compute_backend\":\"rocm\"},\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]},\"native_requirements\":[${requirement}],\"native_providers\":[${runtime}],\"native_extensions\":[{\"name\":\"torch\",\"kind\":\"prebuilt\",\"library\":\"lib/libtorch_package.so\",\"sputnik_ext_abi\":1,\"requirements\":[\"libtorch\"]}]}")
package_manifest_write("${stage}" "${manifest}" ${runtime_files} "lib/libtorch_package.so" README.md meta/requirements.json meta/components.json licenses/PyTorch-LICENSE.txt licenses/Gloo-LICENSE.txt licenses/RCCL-LICENSE.txt)
set(artifact "${OUTPUT}/torch-${PACKAGE_VERSION}-${variant}.sputnikpkg")
execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg build "${stage}" --modules source --out "${artifact}" OUTPUT_FILE "${OUTPUT}/report.json" COMMAND_ERROR_IS_FATAL ANY)
set(consumer "${OUTPUT}/installed-check")
set(installed_home "${OUTPUT}/installed-home")
file(MAKE_DIRECTORY "${consumer}")
file(READ "${ROOT}/tests/rocm_package_check.s" check_source)
string(REPLACE "from torch." "from ${module_prefix}torch." check_source "${check_source}")
file(WRITE "${consumer}/check.s" "${check_source}")
run(cmake -E env --unset=LD_LIBRARY_PATH "SPUTNIK_PKG_HOME=${installed_home}" "SPUTNIK_NATIVE_CXX=/compiler-must-not-run"
  "${SPUTNIK_ROOT}/build/sputnik" pkg install "${artifact}" --backend rocm --variant "${variant}" --bundle runtime --allow-native --allow-native-large)
run(cmake -E env --unset=LD_LIBRARY_PATH "SPUTNIK_PKG_HOME=${installed_home}"
  "${SPUTNIK_ROOT}/build/sputnik" pkg lock "${consumer}/check.s" --backend rocm --variant "${PACKAGE_REF}=${variant}")
execute_process(COMMAND cmake -E env --unset=LD_LIBRARY_PATH "SPUTNIK_PKG_HOME=${installed_home}"
  "${SPUTNIK_ROOT}/build/sputnik" build "${consumer}/check.s" --target native --require-full-native --grant ffi -o "${consumer}/native-check"
  OUTPUT_FILE "${OUTPUT}/native-preflight-build.json" COMMAND_ERROR_IS_FATAL ANY)
foreach(device RANGE 0 2)
  run(cmake -E env --unset=LD_LIBRARY_PATH "HIP_VISIBLE_DEVICES=${device}" "SPUTNIK_PKG_HOME=${installed_home}" "SPUTNIK_NATIVE_CXX=/compiler-must-not-run"
    "${SPUTNIK_ROOT}/build/sputnik" run "${consumer}/check.s" --grant ffi)
  run(cmake -E env --unset=LD_LIBRARY_PATH "HIP_VISIBLE_DEVICES=${device}" "PATH=/nonexistent" "${consumer}/native-check")
endforeach()
message(STATUS "Verified registry ROCm package: ${artifact}")
