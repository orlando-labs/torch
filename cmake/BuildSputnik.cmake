cmake_minimum_required(VERSION 3.27)
# This bootstrap consumes LibTorch headers/libraries only. No interpreter,
# language bindings, or FindPython discovery is part of any build/test target.
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
include("${ROOT}/cmake/BuildJson.cmake")
file(REAL_PATH "${TORCH_PREFIX}" TORCH_PREFIX)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
set(build "${ROOT}/build")
set(gloo_sha "74cc005ae13f69c11d8a41e50b42025b6730e796")
set(gloo_archive_sha "1d7260c64008e5ad430a01f63dfd94a3e04ea663f2694a3834f3877b4da66833")
set(gloo "${build}/deps/gloo-${gloo_sha}")
if(NOT EXISTS "${gloo}/gloo/algorithm.h")
  if(NOT FETCH_DEPS)
    message(FATAL_ERROR "Missing pinned Gloo headers; pass --fetch-deps once")
  endif()
  file(MAKE_DIRECTORY "${build}/deps")
  file(DOWNLOAD "https://codeload.github.com/pytorch/gloo/tar.gz/${gloo_sha}" "${build}/deps/gloo.tar.gz"
       TLS_VERIFY ON EXPECTED_HASH "SHA256=${gloo_archive_sha}" SHOW_PROGRESS)
  file(ARCHIVE_EXTRACT INPUT "${build}/deps/gloo.tar.gz" DESTINATION "${build}/deps")
endif()
file(READ "${TORCH_PREFIX}/include/torch/csrc/api/include/torch/version.h" version_header)
if(version_header MATCHES "torch/headeronly/version.h")
  file(READ "${TORCH_PREFIX}/include/torch/headeronly/version.h" version_header)
endif()
string(REPLACE "\\\n" "" version_header "${version_header}")
string(REGEX MATCH "#define[ \t]+TORCH_VERSION[ \t]+\"([^\"]+)\"" version_match "${version_header}")
set(version "${CMAKE_MATCH_1}")
if(NOT version STREQUAL "2.14.0" AND NOT version STREQUAL "2.14.1")
  message(FATAL_ERROR "Adapter/Gloo headers require LibTorch 2.14.0 or 2.14.1; found '${version}'")
endif()
file(SHA256 "${TORCH_PREFIX}/share/cmake/Torch/TorchConfig.cmake" torch_config_hash)
execute_process(COMMAND clang++ --version OUTPUT_VARIABLE compiler COMMAND_ERROR_IS_FATAL ANY)
quote_json(qcompiler "${compiler}")
quote_json(qprefix "${TORCH_PREFIX}")
file(WRITE "${build}/native-lock.json" "{\n\"torch_version\":\"${version}\",\n\"torch_prefix\":${qprefix},\n\"gloo_commit\":\"${gloo_sha}\",\n\"gloo_archive_sha256\":\"${gloo_archive_sha}\",\n\"compiler\":${qcompiler},\n\"cmake_config_sha256\":\"${torch_config_hash}\"\n}\n")
if(PROBES)
  run(cmake -S "${ROOT}" -B "${build}/native" -G Ninja "-DCMAKE_PREFIX_PATH=${TORCH_PREFIX}"
      "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}" "-DGLOO_INCLUDE_DIR=${gloo}" -DCMAKE_BUILD_TYPE=Release)
  run(cmake --build "${build}/native" -j 3)
endif()
file(REAL_PATH "${ENTRY}" entry BASE_DIRECTORY "${ROOT}")
file(GLOB_RECURSE sources "${ROOT}/src/*.s" "${ROOT}/src/*.spu" "${ROOT}/src/*.sputnik")
file(GLOB test_modules "${ROOT}/tests/*.s" "${ROOT}/tests/*.spu" "${ROOT}/tests/*.sputnik")
file(GLOB_RECURSE example_modules "${ROOT}/examples/mnist/*.s" "${ROOT}/examples/mnist/*.spu" "${ROOT}/examples/mnist/*.sputnik")
list(APPEND sources ${test_modules} ${example_modules} "${entry}")
list(REMOVE_DUPLICATES sources)
set(modules "[]")
set(index 0)
foreach(source IN LISTS sources)
  file(STRINGS "${source}" declaration REGEX "^package[ \t]+" LIMIT_COUNT 1)
  string(REGEX REPLACE "^package[ \t]+" "" name "${declaration}")
  quote_json(qname "${name}")
  quote_json(qpath "${source}")
  string(JSON modules SET "${modules}" ${index} "{\"name\":${qname},\"path\":${qpath}}")
  math(EXPR index "${index}+1")
  if(source STREQUAL entry)
    set(root_name "${name}")
  endif()
endforeach()
set(extension "{\"name\":\"torch\",\"language\":\"c++\"}")
file(GLOB_RECURSE native_sources "${ROOT}/native/*.cpp")
file(GLOB_RECURSE native_headers "${ROOT}/native/*.h")
# Diagnostic entry points are linked only into the FFI benchmark. They are
# neither exported by the package nor part of production adapter builds.
if(entry STREQUAL "${ROOT}/bench/ffi/calls.s")
  list(APPEND native_sources "${ROOT}/bench/ffi/native_calls.cpp" "${ROOT}/bench/ffi/raw_calls.cpp")
  list(APPEND native_headers "${ROOT}/bench/ffi/raw_calls.h")
endif()
if(entry STREQUAL "${ROOT}/tests/recurrent.s" OR entry STREQUAL "${ROOT}/tests/recurrent_mps.s"
    OR entry STREQUAL "${ROOT}/tests/packed.s" OR entry STREQUAL "${ROOT}/tests/packed_mps.s")
  list(APPEND native_sources "${ROOT}/tests/recurrent_reference.cpp")
endif()
if(entry STREQUAL "${ROOT}/tests/attention.s" OR entry STREQUAL "${ROOT}/tests/attention_mps.s")
  list(APPEND native_sources "${ROOT}/tests/attention_reference.cpp")
endif()
json_array(values ${native_sources})
string(JSON extension SET "${extension}" sources "${values}")
json_array(values ${native_headers} "${build}/native-lock.json")
string(JSON extension SET "${extension}" headers "${values}")
json_array(values "${TORCH_PREFIX}/include" "${TORCH_PREFIX}/include/torch/csrc/api/include" "${gloo}" "${ROOT}/native")
string(JSON extension SET "${extension}" include_dirs "${values}")
string(JSON extension SET "${extension}" defines "[\"USE_C10D_GLOO=1\"]")
string(JSON extension SET "${extension}" cxxflags "[\"-std=c++20\"]")
string(JSON extension SET "${extension}" link_libraries "[\"torch\",\"torch_cpu\",\"c10\"]")
json_array(values "${TORCH_PREFIX}/lib")
string(JSON extension SET "${extension}" library_dirs "${values}")
string(JSON extension SET "${extension}" runtime_library_dirs "${values}")
quote_json(qroot "${root_name}")
set(manifest "{\"schema\":\"sputnik.build.v1\",\"name\":${qroot},\"root\":${qroot},\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]}}")
string(JSON manifest SET "${manifest}" modules "${modules}")
string(JSON manifest SET "${manifest}" native_extensions "[${extension}]")
set(manifest_path "${build}/${root_name}.build.json")
file(WRITE "${manifest_path}" "${manifest}\n")
if(MODE STREQUAL "vm")
  run("${SPUTNIK_ROOT}/build/sputnik" run "${manifest_path}" --grant ffi --grant fs.read)
elseif(NOT MODE STREQUAL "notebook")
  if(entry STREQUAL "${ROOT}/bench/ffi/calls.s")
    set(ffi_input_paths ${sources} ${native_sources} ${native_headers}
      "${ROOT}/tools/build" "${ROOT}/cmake/BuildSputnik.cmake"
      "${manifest_path}" "${SPUTNIK_ROOT}/build/sputnik")
    list(REMOVE_DUPLICATES ffi_input_paths)
    set(ffi_inputs "{}")
    foreach(input IN LISTS ffi_input_paths)
      file(SHA256 "${input}" digest)
      quote_json(qdigest "${digest}")
      string(JSON ffi_inputs SET "${ffi_inputs}" "${input}" "${qdigest}")
    endforeach()
  endif()
  run("${SPUTNIK_ROOT}/build/sputnik" build "${manifest_path}" --target native --out-dir "${build}/sputnik" --grant ffi --grant fs.read --require-full-native)
  if(entry STREQUAL "${ROOT}/bench/ffi/calls.s")
    foreach(input IN LISTS ffi_input_paths)
      file(SHA256 "${input}" digest)
      string(JSON previous GET "${ffi_inputs}" "${input}")
      if(NOT digest STREQUAL previous)
        message(FATAL_ERROR "FFI benchmark input changed during build: ${input}")
      endif()
    endforeach()
    file(SHA256 "${build}/sputnik/${root_name}" ffi_native_hash)
    file(WRITE "${build}/ffi-calls-build-inputs.json"
      "{\"native_sha256\":\"${ffi_native_hash}\",\"inputs\":${ffi_inputs}}\n")
  endif()
endif()
if(MODE STREQUAL "notebook" OR NOTEBOOK_PROJECTS OR EXISTS "${build}/notebook/projects.json" OR EXISTS "${build}/notebook/projects")
  include("${ROOT}/cmake/PrepareNotebook.cmake")
  prepare_notebook_bundle()
endif()
