cmake_minimum_required(VERSION 3.27)
include("${ROOT}/cmake/BuildJson.cmake")
include("${ROOT}/cmake/PackageManifest.cmake")
include("${ROOT}/cmake/ValidateComponents.cmake")
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(capture out)
  execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE value ERROR_VARIABLE error RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGN}\n${error}")
  endif()
  string(STRIP "${value}" value)
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(list_json out)
  set(text "[")
  set(separator "")
  foreach(item IN LISTS ARGN)
    quote_json(quoted "${item}")
    string(APPEND text "${separator}${quoted}")
    set(separator ", ")
  endforeach()
  set(${out} "${text}]" PARENT_SCOPE)
endfunction()
capture(host_arch uname -m)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT host_arch STREQUAL "x86_64")
  message(FATAL_ERROR "CUDA recipe is verified on Linux x86_64")
endif()
if(NOT NATIVE_MODE STREQUAL "prebuilt" OR NOT BUNDLE STREQUAL "runtime" OR MATRIX)
  message(FATAL_ERROR "CUDA recipe requires --native prebuilt --bundle runtime; no source-build fallback")
endif()
if(NOT TORCH_PREFIX)
  message(FATAL_ERROR "Pass --torch-prefix pointing to LibTorch 2.14.0+cu130")
endif()
file(REAL_PATH "${TORCH_PREFIX}" TORCH_PREFIX)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
file(REAL_PATH "${ROOT}" ROOT)
get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
file(READ "${TORCH_PREFIX}/build-version" producer)
string(STRIP "${producer}" producer)
if(NOT producer STREQUAL "2.14.0+cu130")
  message(FATAL_ERROR "This CUDA recipe requires exactly LibTorch 2.14.0+cu130; found '${producer}'")
endif()
set(torch_version "2.14.0")
set(cuda_version "13.0")
set(abi "libtorch-2.14.0-cxx11-linux-x86_64-gnu-cu130")
set(prefix "")
set(error_namespace "Torch.Errors")
if(PACKAGE_REF MATCHES "^([a-z][a-z0-9_]*)/torch$")
  set(publisher "${CMAKE_MATCH_1}")
  set(prefix "${publisher}.")
  string(REPLACE "_" ";" words "${publisher}")
  set(camel "")
  foreach(word IN LISTS words)
    if(word STREQUAL "")
      continue()
    endif()
    string(SUBSTRING "${word}" 0 1 initial)
    string(SUBSTRING "${word}" 1 -1 rest)
    string(TOUPPER "${initial}" initial)
    string(APPEND camel "${initial}${rest}")
  endforeach()
  set(error_namespace "${camel}.Torch.Errors")
elseif(NOT PACKAGE_REF STREQUAL "torch")
  message(FATAL_ERROR "Expected torch or publisher/torch")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(LOCK "${OUTPUT}/package.lock" GUARD PROCESS TIMEOUT 0)
set(gloo_commit "74cc005ae13f69c11d8a41e50b42025b6730e796")
set(gloo_sha "1d7260c64008e5ad430a01f63dfd94a3e04ea663f2694a3834f3877b4da66833")
set(gloo "${ROOT}/build/deps/gloo-${gloo_commit}")
if(NOT EXISTS "${gloo}/gloo/algorithm.h")
  file(DOWNLOAD "https://codeload.github.com/pytorch/gloo/tar.gz/${gloo_commit}" "${OUTPUT}/gloo.tar.gz"
    TLS_VERIFY ON EXPECTED_HASH "SHA256=${gloo_sha}")
  file(MAKE_DIRECTORY "${gloo}")
  file(ARCHIVE_EXTRACT INPUT "${OUTPUT}/gloo.tar.gz" DESTINATION "${ROOT}/build/deps")
endif()
set(build "${ROOT}/build/package-cuda")
run(cmake -S "${ROOT}" -B "${build}" -G Ninja "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}"
  "-DSPUTNIKTORCH_PREBUILT_TORCH_ROOT=${TORCH_PREFIX}" "-DGLOO_INCLUDE_DIR=${gloo}"
  "-DSPUTNIKTORCH_ERROR_NAMESPACE=${error_namespace}" -DCMAKE_BUILD_TYPE=Release)
run(cmake --build "${build}" --target torch_package torch_probe torch_execution_mode_test -j 6)
# Keep the ELF identity when staging: the linker records DT_SONAME rather
# than the pathname passed to it. Renaming only the file breaks native apps.
set(adapter_name "libtorch_package.so")
capture(adapter_dynamic readelf -d "${build}/${adapter_name}")
if(NOT adapter_dynamic MATCHES "\\(SONAME\\)[^\n]*\\[${adapter_name}\\]")
  message(FATAL_ERROR "Adapter SONAME differs from its packaged filename")
endif()
# Probe executables exercise LibTorch kernels, but do not load every adapter
# object. Resolve the complete shared adapter too, allowing only the host C ABI.
execute_process(COMMAND cmake -E env "LD_LIBRARY_PATH=${TORCH_PREFIX}/lib" ldd -r "${build}/libtorch_package.so"
  OUTPUT_VARIABLE relocations ERROR_VARIABLE relocation_errors COMMAND_ERROR_IS_FATAL ANY)
string(APPEND relocations "${relocation_errors}")
if(relocations MATCHES "not found")
  message(FATAL_ERROR "Adapter has an unresolved shared library: ${relocations}")
endif()
string(REGEX MATCHALL "undefined symbol:[ \t]+[^ \t\n]+" unresolved "${relocations}")
foreach(symbol IN LISTS unresolved)
  if(NOT symbol MATCHES "undefined symbol:[ \t]+sputnik_[a-zA-Z0-9_]+$")
    message(FATAL_ERROR "Adapter has a non-Sputnik unresolved symbol: ${symbol}")
  endif()
endforeach()
run(cmake -E env "LD_LIBRARY_PATH=${TORCH_PREFIX}/lib" "LD_PRELOAD=${build}/libtorch_package.so"
  LD_BIND_NOW=1 "${SPUTNIK_ROOT}/build/sputnik" --version)
run("${build}/torch_execution_mode_test")
run("${build}/torch_probe" cpu)
set(compute)
set(min_driver "")
foreach(device IN LISTS CUDA_DEVICES)
  capture(facts nvidia-smi "--id=${device}" --query-gpu=driver_version,compute_cap,uuid --format=csv,noheader,nounits)
  if(NOT facts MATCHES "^([0-9.]+),[ \t]*([0-9.]+),[ \t]*(GPU-[a-fA-F0-9-]+)$")
    message(FATAL_ERROR "Cannot establish driver/compute capability for CUDA device ${device}")
  endif()
  set(driver "${CMAKE_MATCH_1}")
  set(capability "${CMAKE_MATCH_2}")
  set(uuid "${CMAKE_MATCH_3}")
  if(min_driver STREQUAL "" OR min_driver VERSION_LESS driver)
    set(min_driver "${driver}")
  endif()
  list(APPEND compute "${capability}")
  list(APPEND verified_uuids "${uuid}")
  run(cmake -E env "CUDA_VISIBLE_DEVICES=${uuid}" "${build}/torch_probe" cuda:0)
endforeach()
list(REMOVE_DUPLICATES compute)
list(SORT compute)
list_json(compute_json ${compute})
set(stage "${OUTPUT}/stage-cuda")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/lib/vendor" "${stage}/meta" "${stage}/licenses")
file(COPY_FILE "${build}/${adapter_name}" "${stage}/lib/${adapter_name}")
file(COPY_FILE "${ROOT}/README.md" "${stage}/README.md")
file(GLOB_RECURSE modules RELATIVE "${ROOT}" "${ROOT}/src/*.s")
list(SORT modules)

foreach(source IN LISTS modules)
  file(READ "${ROOT}/${source}" text)
  if(prefix)
    string(REGEX REPLACE "(^|\n)((package|from|import)[ \t]+)torch([. \t\n])" "\\1\\2${prefix}torch\\4" text "${text}")
  endif()
  get_filename_component(parent "${stage}/${source}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(WRITE "${stage}/${source}" "${text}")
  string(REGEX MATCH "(^|\n)package[ \t]+([^\n]+)" matched "${text}")
  set(module "${CMAKE_MATCH_2}")
endforeach()
# Exercise the actual Sputnik adapter and scoped module/error bindings before
# spending time compressing the runtime or admitting an immutable publication.
set(verification "${OUTPUT}/verify")
set(verification_package "${verification}/packages/${PACKAGE_REF}")
file(MAKE_DIRECTORY "${verification_package}" "${verification}/empty-home")
file(COPY "${stage}/src" DESTINATION "${verification_package}")
file(COPY_FILE "${build}/${adapter_name}" "${verification_package}/${adapter_name}")
file(READ "${ROOT}/tests/registry_cuda_check.s" check_source)
string(REPLACE "slowpilot.torch" "${prefix}torch" check_source "${check_source}")
file(WRITE "${verification}/check.s" "${check_source}")
file(READ "${ROOT}/tests/registry_cuda_checkpoint.s" checkpoint_source)
string(REPLACE "slowpilot.torch" "${prefix}torch" checkpoint_source "${checkpoint_source}")
file(WRITE "${verification}/checkpoint.s" "${checkpoint_source}")
package_inventory(module_files module_names "${stage}")
set(verification_manifest "{\"name\":\"${PACKAGE_REF}\",\"version\":\"${PACKAGE_VERSION}\",\"source_root\":\"src\",\"files\":${module_files},\"module_names\":${module_names},\"target\":{\"os\":\"linux\",\"arch\":\"x86_64\",\"libc\":\"gnu\"},\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]},\"native_extensions\":[{\"name\":\"torch\",\"kind\":\"prebuilt\",\"library\":\"${adapter_name}\",\"sputnik_ext_abi\":1}]}")
package_manifest_write("${verification_package}" "${verification_manifest}" "${adapter_name}")
foreach(uuid IN LISTS verified_uuids)
  run(cmake -E env "CUDA_VISIBLE_DEVICES=${uuid}" "LD_LIBRARY_PATH=${TORCH_PREFIX}/lib"
    "SPUTNIK_PKG_HOME=${verification}/empty-home" "SPUTNIK_NATIVE_CXX=/no/compiler"
    "${SPUTNIK_ROOT}/build/sputnik" run "${verification}/check.s" --grant ffi)
  run(cmake -E env "CUDA_VISIBLE_DEVICES=${uuid}" "LD_LIBRARY_PATH=${TORCH_PREFIX}/lib"
    "SPUTNIK_PKG_HOME=${verification}/empty-home" "SPUTNIK_NATIVE_CXX=/no/compiler"
    "${SPUTNIK_ROOT}/build/sputnik" run "${verification}/checkpoint.s" --grant ffi
    -- --path "${verification}/cuda-checkpoint.pt")
endforeach()
file(REMOVE "${verification}/cuda-checkpoint.pt")
file(GLOB libraries "${TORCH_PREFIX}/lib/*.so" "${TORCH_PREFIX}/lib/*.so.*")
list(SORT libraries)
set(runtime_libraries "[]")
set(runtime_files)
set(build_material "LibTorch 2.14.0+cu130\nGloo ${gloo_commit}\n")
foreach(library IN LISTS libraries)
  get_filename_component(name "${library}" NAME)
  if(name MATCHES "python|test|backend_with_compiler")
    continue()
  endif()
  capture(dynamic readelf -d "${library}")
  if(dynamic MATCHES "libpython|libtorch_python" OR dynamic MATCHES "(RPATH|RUNPATH)[^\n]*\\[/")
    message(FATAL_ERROR "Nonportable/Python runtime dependency in ${name}")
  endif()
  file(COPY_FILE "${library}" "${stage}/lib/vendor/${name}")
  file(SHA256 "${library}" hash)
  string(APPEND build_material "${name}=${hash}\n")
  list(APPEND runtime_files "lib/vendor/${name}")
  string(JSON count LENGTH "${runtime_libraries}")
  string(JSON runtime_libraries SET "${runtime_libraries}" ${count} "{\"path\":\"lib/vendor/${name}\",\"role\":\"dependency\",\"abi\":\"${abi}\"}")
endforeach()
string(SHA256 build_hash "${build_material}")
set(build_id "sha256:${build_hash}")
# Retain upstream license/notice documents alongside the exact runtime payload.
file(DOWNLOAD "https://raw.githubusercontent.com/pytorch/pytorch/2b3ec34829036a65cd9d1398ea72a0167dc37470/LICENSE" "${stage}/licenses/PyTorch-LICENSE.txt" TLS_VERIFY ON STATUS license_status)
list(GET license_status 0 license_code)
if(NOT license_code EQUAL 0)
  message(FATAL_ERROR "Cannot retain upstream LibTorch license")
endif()
file(DOWNLOAD "https://docs.nvidia.com/cuda/archive/13.0.0/eula/index.html" "${stage}/licenses/CUDA-13.0-EULA.html" TLS_VERIFY ON)
file(DOWNLOAD "https://docs.nvidia.com/deeplearning/cudnn/backend/latest/reference/eula.html" "${stage}/licenses/cuDNN-EULA.html" TLS_VERIFY ON)
file(COPY_FILE "${gloo}/LICENSE" "${stage}/licenses/Gloo-LICENSE.txt")
file(WRITE "${stage}/meta/requirements.json" "{\"schema\":\"torch.requirements.v1\",\"libtorch_version\":\"${torch_version}\",\"cuda_version\":\"${cuda_version}\",\"build_id\":\"${build_id}\",\"gloo_commit\":\"${gloo_commit}\",\"verified_devices\":\"${CUDA_DEVICES}\",\"min_driver\":\"${min_driver}\"}\n")
json_array(runtime_json ${runtime_files})
set(materials "[\"licenses/PyTorch-LICENSE.txt\",\"licenses/Gloo-LICENSE.txt\",\"licenses/CUDA-13.0-EULA.html\",\"licenses/cuDNN-EULA.html\"]")
file(WRITE "${stage}/meta/components.json" "{\"schema\":\"sputnik.native-components.v1\",\"components\":[{\"name\":\"LibTorch C++ CUDA runtime distribution\",\"version\":\"${producer}\",\"license\":\"upstream component terms retained in materials\",\"origin\":\"https://download.pytorch.org/libtorch/cu130/libtorch-shared-with-deps-2.14.0%2Bcu130.zip\",\"files\":${runtime_json},\"materials\":${materials}}]}\n")
validate_components("${stage}" "meta/components.json")
set(variant "linux-x86_64-gnu-cu130-prebuilt-${MODULE_MODE}-runtime")
set(runtime "{\"id\":\"libtorch\",\"kind\":\"runtime\",\"version\":\"${torch_version}\",\"abi\":\"${abi}\",\"build_id\":\"${build_id}\",\"library_dirs\":[\"lib/vendor\"],\"link_libraries\":[\"torch\",\"torch_cpu\",\"c10\",\"torch_cuda\",\"c10_cuda\"],\"libraries\":${runtime_libraries}}")
set(requirement "{\"id\":\"libtorch\",\"kind\":\"runtime\",\"version\":\"${torch_version}\",\"abi\":\"${abi}\",\"build_id\":\"${build_id}\",\"provider\":\"bundled\"}")
set(manifest "{\"name\":\"${PACKAGE_REF}\",\"version\":\"${PACKAGE_VERSION}\",\"source_root\":\"src\",\"module_names\":${module_names},\"files\":${module_files},\"artifact\":{\"variant\":\"${variant}\",\"bundle\":\"runtime\",\"limit_profile\":\"native-large\"},\"target\":{\"os\":\"linux\",\"arch\":\"x86_64\",\"libc\":\"gnu\",\"min_libc\":\"2.28\",\"compute_backend\":\"cuda\",\"cuda_version\":\"13.0\",\"min_cuda_driver\":\"${min_driver}\",\"cuda_architectures\":${compute_json}},\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]},\"native_requirements\":[${requirement}],\"native_providers\":[${runtime}],\"native_extensions\":[{\"name\":\"torch\",\"kind\":\"prebuilt\",\"library\":\"lib/${adapter_name}\",\"sputnik_ext_abi\":1,\"requirements\":[\"libtorch\"]}]}")
set(files ${modules} README.md meta/requirements.json meta/components.json licenses/PyTorch-LICENSE.txt licenses/Gloo-LICENSE.txt licenses/CUDA-13.0-EULA.html licenses/cuDNN-EULA.html)
json_array(files_json ${files})
string(JSON manifest SET "${manifest}" files "${files_json}")
package_manifest_write("${stage}" "${manifest}" ${runtime_files} "lib/${adapter_name}")
set(artifact "${OUTPUT}/torch-${PACKAGE_VERSION}-${variant}.sputnikpkg")
execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg build "${stage}" --modules "${MODULE_MODE}" --out "${artifact}"
  OUTPUT_FILE "${OUTPUT}/report.json" COMMAND_ERROR_IS_FATAL ANY)
# Test the actual immutable archive with its bundled libraries, outside the
# local override tree and without the producer's LD_LIBRARY_PATH. A successful
# dlopen alone does not prove that an ELF-linked native application can start.
set(consumer "${OUTPUT}/installed-check")
set(installed_home "${OUTPUT}/installed-home")
file(MAKE_DIRECTORY "${consumer}")
file(WRITE "${consumer}/check.s" "${check_source}")
list(GET verified_uuids 0 first_uuid)
run(cmake -E env --unset=LD_LIBRARY_PATH "CUDA_VISIBLE_DEVICES=${first_uuid}"
  "SPUTNIK_PKG_HOME=${installed_home}" "SPUTNIK_NATIVE_CXX=/no/compiler"
  "${SPUTNIK_ROOT}/build/sputnik" pkg install "${artifact}"
  --backend cuda --bundle runtime --allow-native --allow-native-large)
run(cmake -E env --unset=LD_LIBRARY_PATH "CUDA_VISIBLE_DEVICES=${first_uuid}"
  "SPUTNIK_PKG_HOME=${installed_home}" "SPUTNIK_NATIVE_CXX=/no/compiler"
  "${SPUTNIK_ROOT}/build/sputnik" pkg lock "${consumer}/check.s" --backend cuda)
execute_process(COMMAND cmake -E env --unset=LD_LIBRARY_PATH
  "CUDA_VISIBLE_DEVICES=${first_uuid}" "SPUTNIK_PKG_HOME=${installed_home}"
  "${SPUTNIK_ROOT}/build/sputnik" build "${consumer}/check.s"
  --target native --require-full-native --grant ffi -o "${consumer}/native-check"
  OUTPUT_FILE "${OUTPUT}/native-preflight-build.json" COMMAND_ERROR_IS_FATAL ANY)
foreach(uuid IN LISTS verified_uuids)
  run(cmake -E env --unset=LD_LIBRARY_PATH "CUDA_VISIBLE_DEVICES=${uuid}"
    "SPUTNIK_PKG_HOME=${installed_home}" "SPUTNIK_NATIVE_CXX=/no/compiler"
    "${SPUTNIK_ROOT}/build/sputnik" run "${consumer}/check.s" --grant ffi)
  run(cmake -E env --unset=LD_LIBRARY_PATH "CUDA_VISIBLE_DEVICES=${uuid}"
    "${consumer}/native-check")
endforeach()
message(STATUS "CUDA package: ${artifact}")
