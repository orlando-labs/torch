include_guard(GLOBAL)
include("${ROOT}/cmake/BuildJson.cmake")
# Every producer writes the same build manifest; no second package grammar.
function(package_inventory out_files out_names directory)
  file(GLOB_RECURSE sources RELATIVE "${directory}" "${directory}/src/*.s")
  list(SORT sources)
  json_array(files ${sources})
  set(names "{}")
  foreach(source IN LISTS sources)
    file(STRINGS "${directory}/${source}" declaration REGEX "^package[ \t]+" LIMIT_COUNT 1)
    string(REGEX REPLACE "^package[ \t]+" "" name "${declaration}")
    string(REGEX REPLACE "^src/|\\.s$" "" inferred "${source}")
    string(REPLACE "/" "." inferred "${inferred}")
    if(NOT name STREQUAL inferred)
      string(REPLACE "." "/" module_path "${name}")
      set(canonical "src/${module_path}.s")
      if(EXISTS "${directory}/${canonical}")
        message(FATAL_ERROR "Duplicate module provider: ${name}")
      endif()
      get_filename_component(parent "${directory}/${canonical}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(RENAME "${directory}/${source}" "${directory}/${canonical}")
    endif()
  endforeach()
  file(GLOB_RECURSE canonical_sources RELATIVE "${directory}" "${directory}/src/*.s")
  list(SORT canonical_sources)
  json_array(files ${canonical_sources})
  set(${out_files} "${files}" PARENT_SCOPE)
  set(${out_names} "${names}" PARENT_SCOPE)
endfunction()
function(package_manifest_write directory manifest)
  # Materialize an exact inventory, including all declared native/provider bytes.
  string(JSON files ERROR_VARIABLE error GET "${manifest}" files)
  if(error)
    set(files "[]")
  endif()
  string(JSON count LENGTH "${files}")
  set(unique ${ARGN})
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      string(JSON file GET "${files}" ${index})
      list(APPEND unique "${file}")
    endforeach()
  endif()
  list(REMOVE_DUPLICATES unique)
  list(SORT unique)
  json_array(files ${unique})
  string(JSON manifest SET "${manifest}" files "${files}")
  string(JSON manifest SET "${manifest}" schema "\"sputnik.build.v1\"")
  string(JSON count LENGTH "${manifest}")
  math(EXPR last "${count}-1")
  set(text "")
  foreach(index RANGE ${last})
    string(JSON key MEMBER "${manifest}" ${index})
    string(JSON type TYPE "${manifest}" ${key})
    string(JSON value GET "${manifest}" ${key})
    if(type STREQUAL STRING)
      quote_json(value "${value}")
    else()
      string(REPLACE "\n" " " value "${value}")
    endif()
    string(APPEND text "${key}: ${value}\n")
  endforeach()
  file(REMOVE "${directory}/sputnik.build.json")
  file(WRITE "${directory}/sputnik.build.yaml" "${text}")
endfunction()
