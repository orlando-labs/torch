cmake_minimum_required(VERSION 3.27)
# Package preparation uses CMake/C++ and the Sputnik CLI only. Never Python.
include("${ROOT}/cmake/BuildJson.cmake")
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(capture out)
  execute_process(COMMAND ${ARGN} OUTPUT_VARIABLE value ERROR_VARIABLE error RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGN}\n${error}")
  endif()
  set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(json_string out value)
  quote_json(quoted "${value}")
  set(${out} "${quoted}" PARENT_SCOPE)
endfunction()
function(list_json out)
  set(text "[")
  set(separator "")
  foreach(value IN LISTS ARGN)
    json_string(quoted "${value}")
    string(APPEND text "${separator}${quoted}")
    set(separator ", ")
  endforeach()
  string(APPEND text "]")
  set(${out} "${text}" PARENT_SCOPE)
endfunction()
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
include("${ROOT}/cmake/PackageScope.cmake")

get_filename_component(OUTPUT "${OUTPUT}" ABSOLUTE)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  message(FATAL_ERROR "This LibTorch bundle preparer currently supports macOS; the generic pkg builder is platform independent")
endif()
capture(arch uname -m)
string(STRIP "${arch}" arch)
set(macho_arch "${arch}")
if(arch STREQUAL "arm64")
  set(arch aarch64)
elseif(NOT arch STREQUAL "x86_64")
  message(FATAL_ERROR "Unsupported host architecture: ${arch}")
endif()
if(MATRIX)
  set(NATIVE_MODES source prebuilt)
  set(MODULE_MODES source bytecode mixed)
  set(BUNDLE_MODES none runtime sdk)
else()
  set(NATIVE_MODES "${NATIVE_MODE}")
  set(MODULE_MODES "${MODULE_MODE}")
  set(BUNDLE_MODES "${BUNDLE}")
endif()
set(stage "${OUTPUT}/stage")
file(MAKE_DIRECTORY "${OUTPUT}")
file(LOCK "${OUTPUT}/package.lock" GUARD PROCESS TIMEOUT 0)
if(NOT MATRIX AND NATIVE_MODE STREQUAL "source" AND BUNDLE STREQUAL "none")
  # Packing source must not probe an SDK, compiler, Homebrew or GPU.
  set(source_only TRUE)
  set(torch_version 2.14.0)
  set(minimum 26.0)
  if(PROVIDER_SPEC)
    include("${PROVIDER_SPEC}")
  endif()
  file(REMOVE_RECURSE "${stage}")
  file(MAKE_DIRECTORY "${stage}/meta")
  file(COPY "${ROOT}/src" "${ROOT}/native" DESTINATION "${stage}")
  scope_package_sources("${stage}")
  file(COPY_FILE "${ROOT}/README.md" "${stage}/README.md")
  include("${ROOT}/cmake/PackageMatrix.cmake")
  return()
endif()
if(NOT TORCH_PREFIX)
  capture(TORCH_PREFIX brew --prefix pytorch)
  string(STRIP "${TORCH_PREFIX}" TORCH_PREFIX)
endif()
file(REAL_PATH "${TORCH_PREFIX}" TORCH_PREFIX)
set(gloo "${ROOT}/build/deps/gloo-74cc005ae13f69c11d8a41e50b42025b6730e796")

if(NOT EXISTS "${gloo}/gloo/algorithm.h")
  message(FATAL_ERROR "Run tools/build --fetch-deps once to prepare pinned Gloo headers")
endif()
set(build "${ROOT}/build/package-native-torch")
if(module_prefix)
  set(build "${build}-${publisher}")
endif()
run(cmake -S "${ROOT}" -B "${build}" -G Ninja "-DCMAKE_PREFIX_PATH=${TORCH_PREFIX}"
  "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}" "-DGLOO_INCLUDE_DIR=${gloo}"
  "-DSPUTNIKTORCH_ERROR_NAMESPACE=${error_namespace}" -DCMAKE_BUILD_TYPE=Release)
run(cmake --build "${build}" --target torch_package torch_probe -j 2)
# Verify actual CPU and MPS execution before advertising either backend.
run("${build}/torch_probe" cpu)
run(cmake -E env PYTORCH_ENABLE_MPS_FALLBACK=0 "${build}/torch_probe" mps)
set(stage "${OUTPUT}/stage")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/lib/vendor" "${stage}/licenses" "${stage}/meta")
file(COPY "${ROOT}/src" DESTINATION "${stage}")
scope_package_sources("${stage}")
file(COPY_FILE "${ROOT}/README.md" "${stage}/README.md")
file(COPY_FILE "${build}/libtorch_package.dylib" "${stage}/lib/libtorch_adapter.dylib")
# Follow the installed native dependency graph, then rewrite every import before
# signing/packing. Do not ship Python bindings or execute dependency programs.
set(queue "${build}/libtorch_package.dylib")
set(originals)
set(destinations)
set(names)
set(license_records)
set(component_rows "[]")
set(component_index 0)
set(adapter_import_names)
while(queue)
  list(POP_FRONT queue original)
  file(REAL_PATH "${original}" original)
  if(original IN_LIST originals)
    continue()
  endif()
  if(original STREQUAL "${build}/libtorch_package.dylib")
    set(destination "${stage}/lib/libtorch_adapter.dylib")
    set(name libtorch_adapter.dylib)
  else()
    get_filename_component(name "${original}" NAME)
    if(name IN_LIST names)
      message(FATAL_ERROR "Two native libraries have the same bundle basename: ${name}")
    endif()
    set(destination "${stage}/lib/vendor/${name}")
    file(COPY_FILE "${original}" "${destination}")
  endif()
  list(APPEND originals "${original}")
  list(APPEND destinations "${destination}")
  list(APPEND names "${name}")
  capture(imports otool -arch "${macho_arch}" -L "${original}")
  string(REPLACE "\n" ";" import_lines "${imports}")
  foreach(line IN LISTS import_lines)
    if(NOT line MATCHES "^[ \t]+([^ \t]+)[ \t]+\\(compatibility")
      continue()
    endif()
    set(dependency "${CMAKE_MATCH_1}")
    if(dependency MATCHES "^/usr/lib/" OR dependency MATCHES "^/System/Library/")
      continue()
    endif()
    get_filename_component(original_dir "${original}" DIRECTORY)
    if(dependency MATCHES "^@rpath/(.+)")
      set(suffix "${CMAKE_MATCH_1}")
      if(EXISTS "${original_dir}/${suffix}")
        set(dependency "${original_dir}/${suffix}")
      elseif(EXISTS "${TORCH_PREFIX}/lib/${suffix}")
        set(dependency "${TORCH_PREFIX}/lib/${suffix}")
      else()
        message(FATAL_ERROR "Cannot resolve ${dependency} from ${original}")
      endif()
    elseif(dependency MATCHES "^@loader_path/(.+)")
      set(dependency "${original_dir}/${CMAKE_MATCH_1}")
    elseif(NOT IS_ABSOLUTE "${dependency}")
      message(FATAL_ERROR "Unsupported native import: ${dependency}")
    endif()
    file(REAL_PATH "${dependency}" dependency)
    if(NOT dependency STREQUAL original)
      list(APPEND queue "${dependency}")
    endif()
  endforeach()
  if(original MATCHES "^(/opt/homebrew/Cellar/([^/]+)/([^/]+))/")
    set(prefix "${CMAKE_MATCH_1}")
    set(formula "${CMAKE_MATCH_2}")
    set(component_version "${CMAKE_MATCH_3}")
    if(NOT formula IN_LIST license_records)
      list(APPEND license_records "${formula}")
      set(component_files_${formula})
      set(component_licenses_${formula})
      file(GLOB notices "${prefix}/LICENSE*" "${prefix}/COPYING*" "${prefix}/NOTICE*")
      foreach(notice IN LISTS notices)
        if(NOT IS_DIRECTORY "${notice}")
          get_filename_component(base "${notice}" NAME)
          file(MAKE_DIRECTORY "${stage}/licenses/${formula}")
          file(COPY_FILE "${notice}" "${stage}/licenses/${formula}/${base}")
          list(APPEND component_licenses_${formula} "licenses/${formula}/${base}")
        endif()
      endforeach()
      if(NOT component_licenses_${formula})
        message(FATAL_ERROR "Missing license materials for runtime component ${formula}")
      endif()
      file(STRINGS "${prefix}/.brew/${formula}.rb" license REGEX "^  license " LIMIT_COUNT 1)
      if(license MATCHES "license all_of: ")
        string(REGEX MATCHALL "\"[^\"]+\"" license_parts "${license}")
        set(component_license_${formula} "")
        foreach(part IN LISTS license_parts)
          string(REPLACE "\"" "" part "${part}")
          if(component_license_${formula})
            string(APPEND component_license_${formula} " AND ")
          endif()
          string(APPEND component_license_${formula} "${part}")
        endforeach()
      elseif(license MATCHES "license \"([^\"]+)\"")
        set(component_license_${formula} "${CMAKE_MATCH_1}")
      else()
        message(FATAL_ERROR "No explicit license metadata for ${formula}")
      endif()
      if(license MATCHES "with: \"([^\"]+)\"")
        string(APPEND component_license_${formula} " WITH ${CMAKE_MATCH_1}")
      endif()
      set(component_version_${formula} "${component_version}")
      file(COPY_FILE "${prefix}/.brew/${formula}.rb" "${stage}/licenses/${formula}/homebrew-formula.rb")
      list(APPEND component_licenses_${formula} "licenses/${formula}/homebrew-formula.rb")
    endif()
    file(RELATIVE_PATH relative "${stage}" "${destination}")
    list(APPEND component_files_${formula} "${relative}")
  elseif(NOT original STREQUAL "${build}/libtorch_package.dylib")
    message(FATAL_ERROR "Runtime component lacks a provenance/license recipe: ${original}")
  endif()

endwhile()
set(minimum 0.0)
list(LENGTH originals library_count)
math(EXPR last "${library_count} - 1")
foreach(index RANGE ${last})
  list(GET originals ${index} original)
  list(GET destinations ${index} destination)
  get_filename_component(name "${destination}" NAME)
  run(chmod u+w "${destination}")
  capture(architectures lipo -info "${destination}")
  if(architectures MATCHES "^Architectures in the fat file:")
    run(lipo "${original}" -thin "${macho_arch}" -output "${destination}")
  endif()
  run(codesign --remove-signature "${destination}")
  set(rewrite_arguments)
  capture(imports otool -arch "${macho_arch}" -L "${original}")
  string(REPLACE "\n" ";" import_lines "${imports}")
  foreach(line IN LISTS import_lines)
    if(NOT line MATCHES "^[ \t]+([^ \t]+)[ \t]+\\(compatibility")
      continue()
    endif()
    set(dependency "${CMAKE_MATCH_1}")
    if(dependency MATCHES "^/usr/lib/" OR dependency MATCHES "^/System/Library/")
      continue()
    endif()
    get_filename_component(original_dir "${original}" DIRECTORY)
    if(dependency MATCHES "^@rpath/(.+)")
      set(suffix "${CMAKE_MATCH_1}")
      if(EXISTS "${original_dir}/${suffix}")
        set(resolved "${original_dir}/${suffix}")
      else()
        set(resolved "${TORCH_PREFIX}/lib/${suffix}")
      endif()
    elseif(dependency MATCHES "^@loader_path/(.+)")
      set(resolved "${original_dir}/${CMAKE_MATCH_1}")
    else()
      set(resolved "${dependency}")
    endif()
    file(REAL_PATH "${resolved}" resolved)
    list(FIND originals "${resolved}" dependency_index)
    if(dependency_index LESS 0)
      message(FATAL_ERROR "Native dependency was not bundled: ${dependency}")
    endif()
    list(GET destinations ${dependency_index} dependency_destination)
    get_filename_component(base "${dependency_destination}" NAME)
    if(destination STREQUAL "${stage}/lib/libtorch_adapter.dylib")
      set(replacement "@loader_path/vendor/${base}")
    else()
      set(replacement "@loader_path/${base}")
    endif()
    if(destination STREQUAL "${stage}/lib/libtorch_adapter.dylib" AND NOT resolved STREQUAL original)
      list(APPEND adapter_import_names "${base}")
    endif()
    list(APPEND rewrite_arguments -change "${dependency}" "${replacement}")

  endforeach()
  capture(commands otool -arch "${macho_arch}" -l "${original}")
  string(REGEX MATCHALL "path [^\n]+ \\(offset [0-9]+\\)" rpaths "${commands}")
  foreach(rpath IN LISTS rpaths)
    string(REGEX REPLACE "^path (.*) \\(offset [0-9]+\\)$" "\\1" rpath "${rpath}")
    list(APPEND rewrite_arguments -delete_rpath "${rpath}")
  endforeach()
  # otool emits minos for LC_BUILD_VERSION and version for older macOS commands.
  string(REGEX MATCH "minos ([0-9.]+)" min_match "${commands}")
  if(min_match AND CMAKE_MATCH_1 VERSION_GREATER minimum)
    set(minimum "${CMAKE_MATCH_1}")
  endif()
  run(install_name_tool ${rewrite_arguments} -id "@rpath/${name}" "${destination}")
endforeach()
# Sign dependency leaves before the extension. All bytes are final before hashing.
foreach(destination IN LISTS destinations)
  run(codesign --force --sign - --timestamp=none "${destination}")
endforeach()
file(READ "${TORCH_PREFIX}/include/torch/headeronly/version.h" version_header)
string(REPLACE "\\\n" "" version_header "${version_header}")
string(REGEX MATCH "#define[ \t]+TORCH_VERSION[ \t]+\"([^\"]+)\"" matched "${version_header}")
set(torch_version "${CMAKE_MATCH_1}")
quote_json(qtorch "${torch_version}")
quote_json(qminimum "${minimum}")
quote_json(qarchive "${library_count}")
file(WRITE "${stage}/meta/libtorch.json"
  "{\"schema\":\"torch.libtorch-bundle.v1\",\"libtorch_version\":${qtorch},\"native_abi\":1,\"min_os\":${qminimum},\"bundled_libraries\":${library_count},\"verified_backends\":[\"cpu\",\"mps\"]}\n")
# Native source variants include the exact SDK headers and the same relocated
# dependency libraries. They can be rebuilt on this platform without Homebrew paths.
file(COPY "${ROOT}/native" DESTINATION "${stage}")
file(MAKE_DIRECTORY "${stage}/sdk/torch" "${stage}/sdk/gloo")
file(MAKE_DIRECTORY "${stage}/sdk/torch/include")
# Ship the compiler-observed transitive header closure for this adapter/target.
# Homebrew exposes these directories through symlinks; materialize regular files.
capture(dependencies ninja -C "${build}" -t deps)
string(REPLACE "\n" ";" dependency_lines "${dependencies}")
set(sdk_headers)
foreach(line IN LISTS dependency_lines)
  if(line MATCHES "^    (${TORCH_PREFIX}/include/.+)$")
    list(APPEND sdk_headers "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(REMOVE_DUPLICATES sdk_headers)
if(NOT sdk_headers)
  message(FATAL_ERROR "Ninja did not report the LibTorch SDK header closure")
endif()
foreach(header IN LISTS sdk_headers)
  file(RELATIVE_PATH relative "${TORCH_PREFIX}/include" "${header}")
  get_filename_component(parent "${stage}/sdk/torch/include/${relative}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(COPY_FILE "${header}" "${stage}/sdk/torch/include/${relative}")
endforeach()
file(COPY "${gloo}/gloo" DESTINATION "${stage}/sdk/gloo")
file(MAKE_DIRECTORY "${stage}/licenses/gloo")
file(COPY "${gloo}/LICENSE" DESTINATION "${stage}/licenses/gloo")
# Build identity pins the upstream binary build and SDK used by the adapter.
set(build_material "libtorch-${torch_version}\ngloo-74cc005ae13f69c11d8a41e50b42025b6730e796\n")
foreach(original IN LISTS originals)
  if(original STREQUAL "${build}/libtorch_package.dylib")
    continue()
  endif()
  get_filename_component(name "${original}" NAME)
  file(SHA256 "${original}" digest)
  string(APPEND build_material "${name}=${digest}\n")
endforeach()
foreach(header IN LISTS sdk_headers)
  file(RELATIVE_PATH relative "${TORCH_PREFIX}/include" "${header}")
  file(SHA256 "${header}" digest)
  string(APPEND build_material "${relative}=${digest}\n")
endforeach()
string(SHA256 build_hash "${build_material}")
set(build_id "sha256:${build_hash}")
foreach(formula IN LISTS license_records)
  set(component "{}")
  foreach(field name version license origin)
    if(field STREQUAL "name")
      set(value "${formula}")
    elseif(field STREQUAL "version")
      set(value "${component_version_${formula}}")
    elseif(field STREQUAL "license")
      set(value "${component_license_${formula}}")
    else()
      set(value "Homebrew ${formula}; recipe included with license materials")
    endif()
    quote_json(quoted "${value}")
    string(JSON component SET "${component}" ${field} "${quoted}")
  endforeach()
  json_array(values ${component_files_${formula}})
  string(JSON component SET "${component}" files "${values}")
  json_array(values ${component_licenses_${formula}})
  string(JSON component SET "${component}" materials "${values}")
  quote_json(quoted "${build_id}")
  string(JSON component SET "${component}" build_id "${quoted}")
  string(JSON component_rows SET "${component_rows}" ${component_index} "${component}")
  math(EXPR component_index "${component_index}+1")
endforeach()
file(WRITE "${stage}/meta/runtime-components.json" "{\"schema\":\"sputnik.native-components.v1\",\"components\":${component_rows}}\n")
file(GLOB_RECURSE torch_assets RELATIVE "${stage}" "${stage}/sdk/torch/*")
file(GLOB_RECURSE gloo_assets RELATIVE "${stage}" "${stage}/sdk/gloo/*")
json_array(torch_assets_json ${torch_assets})
json_array(gloo_assets_json ${gloo_assets})
file(WRITE "${stage}/meta/sdk-components.json" "{\"schema\":\"sputnik.native-components.v1\",\"components\":[{\"name\":\"LibTorch SDK\",\"version\":\"${torch_version}\",\"license\":\"BSD-3-Clause\",\"origin\":\"same Homebrew PyTorch build; embedded/header terms retained in files and upstream NOTICE\",\"files\":${torch_assets_json},\"materials\":[\"licenses/pytorch/LICENSE\",\"licenses/pytorch/NOTICE\"]},{\"name\":\"Gloo SDK\",\"version\":\"74cc005ae13f69c11d8a41e50b42025b6730e796\",\"license\":\"BSD-3-Clause\",\"origin\":\"pinned upstream Gloo source\",\"files\":${gloo_assets_json},\"materials\":[\"licenses/gloo/LICENSE\"]}]}\n")
include("${ROOT}/cmake/PackageMatrix.cmake")
