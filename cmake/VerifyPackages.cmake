cmake_minimum_required(VERSION 3.27)
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
file(REAL_PATH "${PACKAGES}" PACKAGES)
file(READ "${PACKAGES}/report.json" report)
file(SHA256 "${PACKAGES}/report.json" matrix_digest)
string(JSON count LENGTH "${report}" packages)
if(NOT count EQUAL 15)
  message(FATAL_ERROR "Expected all 15 current-platform module/native/bundle variants; build with --matrix")
endif()
set(cli "${SPUTNIK_ROOT}/build/sputnik")
set(work "${PACKAGES}/verification")
file(MAKE_DIRECTORY "${work}/packages")
file(LOCK "${work}/verify.lock" GUARD PROCESS TIMEOUT 0)
file(REMOVE "${work}/result.json")
file(COPY_FILE "${ROOT}/tests/package_smoke.s" "${work}/package_smoke.s")
function(run)
  execute_process(COMMAND ${ARGV} WORKING_DIRECTORY "${work}" COMMAND_ERROR_IS_FATAL ANY)
endfunction()
run("${SPUTNIK_ROOT}/build/package_distribution_tests")
run(cmake "-DWORK=${work}/component-tests" -P "${ROOT}/tests/package_components.cmake")
# Fresh relocated provider descriptors; originals from the publisher are not used.
file(REMOVE_RECURSE "${work}/providers")
string(JSON provider_count LENGTH "${report}" providers)
if(NOT provider_count EQUAL 2)
  message(FATAL_ERROR "Missing separate runtime/SDK providers")
endif()
foreach(index RANGE 1)
  foreach(field name version variant sha256)
    string(JSON ${field} GET "${report}" providers ${index} ${field})
  endforeach()
  set(artifact "${PACKAGES}/${name}-${version}-${variant}.sputnikpkg")
  file(SHA256 "${artifact}" actual)
  if(NOT sha256 STREQUAL "sha256:${actual}")
    message(FATAL_ERROR "Provider/report digest mismatch")
  endif()
  if(index EQUAL 0)
    set(provider_kind runtime)
  else()
    set(provider_kind sdk)
  endif()
  execute_process(COMMAND "${cli}" pkg extract "${artifact}" "${work}/providers/${provider_kind}"
    OUTPUT_FILE "${work}/${provider_kind}-inspection.json" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
set(cache "${work}/native-cache")
set(full_native_count 0)
math(EXPR last "${count}-1")
# Check prebuilt dependency views before the more expensive source builds.
set(indices)
foreach(adapter prebuilt source)
  foreach(index RANGE ${last})
    string(JSON kind GET "${report}" packages ${index} native_adapter)
    if(kind STREQUAL adapter)
      list(APPEND indices ${index})
    endif()
  endforeach()
endforeach()
foreach(index IN LISTS indices)
  foreach(field name version variant sha256 native_adapter bundle module_mode)
    string(JSON ${field} GET "${report}" packages ${index} ${field})
  endforeach()
  set(artifact "${PACKAGES}/${name}-${version}-${variant}.sputnikpkg")
  file(SHA256 "${artifact}" actual)
  if(NOT sha256 STREQUAL "sha256:${actual}")
    message(FATAL_ERROR "Artifact/report digest mismatch: ${variant}")
  endif()
  file(REMOVE_RECURSE "${work}/unpack" "${work}/packages/torch")
  execute_process(COMMAND "${cli}" pkg extract "${artifact}" "${work}/unpack"
    OUTPUT_FILE "${work}/${variant}-inspection.json" COMMAND_ERROR_IS_FATAL ANY)
  file(RENAME "${work}/unpack" "${work}/packages/torch")
  set(bindings "")
  if(bundle STREQUAL "none")
    set(bindings "${work}/providers/runtime")
  endif()
  if(native_adapter STREQUAL "source" AND NOT bundle STREQUAL "sdk")
    if(bindings)
      string(APPEND bindings ":")
    endif()
    string(APPEND bindings "${work}/providers/sdk")
  endif()
  # Verify a missing provider is diagnosed before any attempted native compilation.
  if(index EQUAL 0)
    execute_process(COMMAND cmake -E env SPUTNIK_NATIVE_PROVIDERS=
      SPUTNIK_NATIVE_CXX=/compiler-must-not-run SPUTNIK_NATIVE_EXT_CACHE=${cache}
      "${cli}" run "${work}/package_smoke.s" --grant ffi
      WORKING_DIRECTORY "${work}" RESULT_VARIABLE status ERROR_VARIABLE error OUTPUT_QUIET)
    if(status EQUAL 0 OR NOT error MATCHES "missing native provider")
      message(FATAL_ERROR "Missing provider was not diagnosed: ${error}")
    endif()
  endif()
  message(STATUS "Testing relocated ${variant}")
  set(environment PYTORCH_ENABLE_MPS_FALLBACK=0 "SPUTNIK_NATIVE_PROVIDERS=${bindings}" "SPUTNIK_NATIVE_EXT_CACHE=${cache}")
  if(native_adapter STREQUAL "prebuilt")
    run(cmake -E env ${environment} SPUTNIK_NATIVE_CXX=/compiler-must-not-run
      "${cli}" run "${work}/package_smoke.s" --grant ffi)
  else()
    run(cmake -E env ${environment} "${cli}" run "${work}/package_smoke.s" --grant ffi)
  endif()
  if(module_mode STREQUAL "bytecode")
    run(cmake -E env ${environment} "${cli}" build "${work}/package_smoke.s"
      --out "${work}/package-smoke-native" --grant ffi --require-full-native)
    # Prepared native executables no longer need SDK resolution or a C++ compiler.
    run(cmake -E env PYTORCH_ENABLE_MPS_FALLBACK=0 SPUTNIK_NATIVE_PROVIDERS=
      SPUTNIK_NATIVE_CXX=/compiler-must-not-run "${work}/package-smoke-native")
    math(EXPR full_native_count "${full_native_count}+1")
  endif()
endforeach()
# Prove source packing has no SDK/compiler/backend dependency and is reproducible.
run(cmake -E env LIBTORCH_PREFIX=/sdk-must-not-exist SPUTNIK_NATIVE_CXX=/compiler-must-not-run
  "${ROOT}/tools/package" --out-dir "${work}/slim-repack" --version "${version}"
  --sputnik-root "${SPUTNIK_ROOT}" --provider-spec "${PACKAGES}/provider-spec.cmake")
string(JSON expected GET "${report}" packages 0 sha256)
file(READ "${work}/slim-repack/report.json" repacked)
string(JSON actual GET "${repacked}" packages 0 sha256)
if(NOT expected STREQUAL actual)
  message(FATAL_ERROR "Slim package did not reproduce without an SDK")
endif()
file(WRITE "${work}/result.json"
  "{\"schema\":\"torch.package-verification.v1\",\"matrix_sha256\":\"${matrix_digest}\",\"variants\":${count},\"vm\":\"passed\",\"full_native_combinations\":${full_native_count},\"full_native\":\"passed\",\"backends\":[\"cpu\",\"mps\"],\"mps_fallback\":false,\"slim_sdk_free_reproducible\":true,\"missing_provider\":\"passed\"}\n")
set(OUTPUT "${PACKAGES}")
include("${ROOT}/cmake/PackageReport.cmake")
message(STATUS "All 15 variants passed CPU/MPS; all five native/bundle combinations passed full-native")
