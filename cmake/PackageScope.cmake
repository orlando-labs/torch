# Scope the same public module set across platform variants of one release.
if(NOT PACKAGE_REF)
  set(PACKAGE_REF torch)
endif()
set(module_prefix "")
set(error_namespace "Torch.Errors")
if(PACKAGE_REF MATCHES "^([a-z][a-z0-9_]*)/torch$")
  set(publisher "${CMAKE_MATCH_1}")
  set(module_prefix "${publisher}.")
  string(REPLACE "_" ";" words "${publisher}")
  set(camel "")
  foreach(word IN LISTS words)
    if(word STREQUAL "")
      continue()
    endif()
    string(SUBSTRING "${word}" 0 1 initial)
    string(SUBSTRING "${word}" 1 -1 rest)
    string(TOUPPER "${initial}" initial)
    string(APPEND camel "${initial}${rest}")
  endforeach()
  set(error_namespace "${camel}.Torch.Errors")
elseif(NOT PACKAGE_REF STREQUAL "torch")
  message(FATAL_ERROR "Expected torch or publisher/torch")
endif()

function(scope_package_sources directory)
  if(NOT module_prefix)
    return()
  endif()
  file(GLOB_RECURSE sources "${directory}/src/*.s")
  foreach(source IN LISTS sources)
    file(READ "${source}" text)
    string(REGEX REPLACE "(^|\n)((package|from|import)[ \t]+)torch([. \t\n])"
      "\\1\\2${module_prefix}torch\\4" text "${text}")
    file(WRITE "${source}" "${text}")
  endforeach()
endfunction()
