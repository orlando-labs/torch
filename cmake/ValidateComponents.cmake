# Validate declared attribution mapping against the exact staged payload.
function(validate_components stage metadata)
  file(READ "${stage}/${metadata}" inventory)
  string(JSON schema GET "${inventory}" schema)
  if(NOT schema STREQUAL "sputnik.native-components.v1")
    message(FATAL_ERROR "Unknown component inventory schema")
  endif()
  string(JSON count LENGTH "${inventory}" components)
  math(EXPR last "${count}-1")
  set(mapped)
  foreach(index RANGE ${last})
    foreach(field name version license origin)
      string(JSON value GET "${inventory}" components ${index} ${field})
      if(NOT value OR value STREQUAL "NOASSERTION")
        message(FATAL_ERROR "Missing component ${field} for ${metadata}")
      endif()
    endforeach()
    foreach(field files materials)
      string(JSON entries LENGTH "${inventory}" components ${index} ${field})
      if(entries EQUAL 0)
        message(FATAL_ERROR "Empty component ${field}")
      endif()
      math(EXPR entry_last "${entries}-1")
      foreach(entry RANGE ${entry_last})
        string(JSON path GET "${inventory}" components ${index} ${field} ${entry})
        if(path MATCHES "(^/|(^|/)\\.\\.(/|$))" OR NOT EXISTS "${stage}/${path}" OR IS_DIRECTORY "${stage}/${path}")
          message(FATAL_ERROR "Missing/unsafe component ${field}: ${path}")
        endif()
        if(field STREQUAL "files")
          list(APPEND mapped "${path}")
        endif()
      endforeach()
    endforeach()
  endforeach()
  file(GLOB_RECURSE payload RELATIVE "${stage}" "${stage}/lib/vendor/*")
  if(metadata MATCHES "sdk" OR INVENTORY_HAS_SDK)
    file(GLOB_RECURSE sdk_payload RELATIVE "${stage}" "${stage}/sdk/*")
    list(APPEND payload ${sdk_payload})
  endif()
  # A standalone SDK inventory intentionally contains no runtime components.
  if(metadata MATCHES "sdk")
    set(payload ${sdk_payload})
  endif()
  foreach(path IN LISTS payload)
    if(NOT path IN_LIST mapped)
      message(FATAL_ERROR "No attribution mapping for ${path}")
    endif()
  endforeach()
endfunction()
