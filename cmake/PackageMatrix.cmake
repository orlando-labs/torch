include("${ROOT}/cmake/ValidateComponents.cmake")
# Independent module representation, native adapter and third-party bundle axes.
file(GLOB_RECURSE modules RELATIVE "${stage}" "${stage}/src/*.s")
list(SORT modules)
set(module_table "")
foreach(source IN LISTS modules)
  file(STRINGS "${stage}/${source}" declaration REGEX "^package[ \t]+" LIMIT_COUNT 1)
  string(REGEX REPLACE "^package[ \t]+" "" module "${declaration}")
  string(APPEND module_table "\n[[modules]]\nname = \"${module}\"\nsource = \"${source}\"\n")
endforeach()
file(GLOB_RECURSE cpp RELATIVE "${stage}" "${stage}/native/*.cpp")
file(GLOB_RECURSE headers RELATIVE "${stage}" "${stage}/native/*.h")
list_toml(cpp_toml ${cpp})
list_toml(headers_toml ${headers})
set(target_table "[target]\nos = \"macos\"\narch = \"${arch}\"\nmin_os = \"${minimum}\"\ncompute_backend = \"none\"\ncompute_backends = [\"cpu\", \"mps\"]\n")
set(abi "libtorch-${torch_version}-macos-${arch}")
if(NOT DEFINED build_id)
  set(build_id "")
endif()
set(runtime_provider "")
set(sdk_provider "")
set(provider_rows "[]")
if(NOT source_only)
  set(runtime_provider "\n[[native_providers]]\nid = \"libtorch\"\nkind = \"runtime\"\nversion = \"${torch_version}\"\nabi = \"${abi}\"\nbuild_id = \"${build_id}\"\nlibrary_dirs = [\"lib/vendor\"]\nlink_libraries = [\"torch\", \"torch_cpu\", \"c10\"]\n")
  file(GLOB_RECURSE license_files RELATIVE "${stage}" "${stage}/licenses/*")
  list(FILTER license_files EXCLUDE REGEX "^licenses/gloo/")
  list_toml(runtime_files ${license_files})
  string(APPEND runtime_provider "files = ${runtime_files}\n")
  set(runtime_names)
  foreach(destination IN LISTS destinations)
    if(destination STREQUAL "${stage}/lib/libtorch_adapter.dylib")
      continue()
    endif()
    file(RELATIVE_PATH relative "${stage}" "${destination}")
    get_filename_component(name "${destination}" NAME)
    list(APPEND runtime_names "${name}")
    string(APPEND runtime_provider "\n[[native_providers.libraries]]\npath = \"${relative}\"\nabi = \"${abi}\"\n")
  endforeach()
  file(GLOB_RECURSE sdk_files RELATIVE "${stage}" "${stage}/sdk/*")
  list(APPEND sdk_files "licenses/gloo/LICENSE")
  file(GLOB torch_licenses RELATIVE "${stage}" "${stage}/licenses/pytorch/*")
  list(APPEND sdk_files ${torch_licenses})
  list(SORT sdk_files)
  list_toml(sdk_files_toml ${sdk_files})
  set(sdk_provider "\n[[native_providers]]\nid = \"libtorch-sdk\"\nkind = \"sdk\"\nversion = \"${torch_version}\"\nabi = \"${abi}\"\nbuild_id = \"${build_id}\"\nruntime_build_id = \"${build_id}\"\ninclude_dirs = [\"sdk/torch/include\", \"sdk/torch/include/torch/csrc/api/include\", \"sdk/gloo\"]\nfiles = ${sdk_files_toml}\n")
  # Native-only descriptors support explicit local binding without fake modules.
  foreach(provider_kind runtime sdk)
    set(provider_name "torch-libtorch-${provider_kind}")
    set(provider_variant "macos-${arch}")
    set(provider_metadata "${${provider_kind}_provider}")
    validate_components("${stage}" "meta/${provider_kind}-components.json")
    file(COPY_FILE "${stage}/meta/${provider_kind}-components.json" "${stage}/meta/components.json")
    file(WRITE "${stage}/sputnik.toml" "schema = \"sputnik.package-manifest.v1\"\n[package]\nname = \"${provider_name}\"\nversion = \"${PACKAGE_VERSION}\"\nkind = \"native\"\n[artifact]\nvariant = \"${provider_variant}\"\nlimit_profile = \"native-large\"\n${target_table}\n[files]\ninclude = [\"meta/components.json\"]\n${provider_metadata}")
    set(artifact "${OUTPUT}/${provider_name}-${PACKAGE_VERSION}-${provider_variant}.sputnikpkg")
    execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg build "${stage}" --out "${artifact}"
      OUTPUT_VARIABLE info COMMAND_ERROR_IS_FATAL ANY)
    if(provider_kind STREQUAL "runtime")
      set(provider_index 0)
    else()
      set(provider_index 1)
    endif()
    string(JSON provider_rows SET "${provider_rows}" ${provider_index} "${info}")
    file(REMOVE_RECURSE "${OUTPUT}/providers/${provider_kind}")
    execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg extract "${artifact}" "${OUTPUT}/providers/${provider_kind}"
      OUTPUT_FILE "${OUTPUT}/${provider_name}.json" COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  file(WRITE "${OUTPUT}/provider-spec.cmake" "set(torch_version \"${torch_version}\")\nset(minimum \"${minimum}\")\nset(build_id \"${build_id}\")\n")
endif()
set(rows "[]")
set(row 0)
foreach(native_mode IN LISTS NATIVE_MODES)
  foreach(bundle IN LISTS BUNDLE_MODES)
    if(native_mode STREQUAL "prebuilt" AND bundle STREQUAL "sdk")
      continue()
    endif()
    foreach(module_mode IN LISTS MODULE_MODES)
      set(variant "macos-${arch}-${native_mode}-${module_mode}-${bundle}")
      set(limit_profile native-large)
      if(bundle STREQUAL "none" AND native_mode STREQUAL "source")
        set(limit_profile standard)
      endif()
      set(common "schema = \"sputnik.package-manifest.v1\"\n[package]\nname = \"${PACKAGE_REF}\"\nversion = \"${PACKAGE_VERSION}\"\nroot = \"${module_prefix}torch\"\n[artifact]\nvariant = \"${variant}\"\nbundle = \"${bundle}\"\nlimit_profile = \"${limit_profile}\"\n${target_table}${module_table}")
      if(bundle STREQUAL "none")
        set(runtime_delivery external)
        set(providers "")
      else()
        set(runtime_delivery bundled)
        set(providers "${runtime_provider}")
      endif()
      set(requirements "\n[[native_requirements]]\nid = \"libtorch\"\nkind = \"runtime\"\nversion = \"${torch_version}\"\nabi = \"${abi}\"\nbuild_id = \"${build_id}\"\nprovider = \"${runtime_delivery}\"\n")
      # A thin prebuilt adapter declares every non-system import by basename.
      if(native_mode STREQUAL "prebuilt")
        list_toml(import_names ${adapter_import_names})
        string(APPEND requirements "libraries = ${import_names}\n")
      endif()
      set(native "\n[[native]]\nname = \"torch\"\nkind = \"${native_mode}\"\n")
      set(pack "[\"README.md\", \"meta/requirements.json\"]")
      if(native_mode STREQUAL "source")
        if(bundle STREQUAL "sdk")
          set(sdk_delivery bundled)
          string(APPEND providers "${sdk_provider}")
        else()
          set(sdk_delivery external)
        endif()
        string(APPEND requirements "\n[[native_requirements]]\nid = \"libtorch-sdk\"\nkind = \"sdk\"\nversion = \"${torch_version}\"\nabi = \"${abi}\"\nbuild_id = \"${build_id}\"\nprovider = \"${sdk_delivery}\"\nruntime = \"libtorch\"\n")
        list_toml(defines_toml "USE_C10D_GLOO=1" "SPUTNIKTORCH_ERROR_NAMESPACE=\"${error_namespace}\"")
        string(APPEND native "requirements = [\"libtorch\", \"libtorch-sdk\"]\nlanguage = \"c++\"\nsources = ${cpp_toml}\nheaders = ${headers_toml}\ninclude_dirs = [\"native\"]\ndefines = ${defines_toml}\ncxxflags = [\"-std=c++20\"]\n")
      else()
        string(APPEND native "requirements = [\"libtorch\"]\nlibrary = \"lib/libtorch_adapter.dylib\"\nsputnik_ext_abi = 1\n")
      endif()
      if(NOT bundle STREQUAL "none")
        set(pack "[\"README.md\", \"meta/requirements.json\", \"meta/components.json\"]")
        file(READ "${stage}/meta/runtime-components.json" components)
        if(bundle STREQUAL "sdk")
          file(READ "${stage}/meta/sdk-components.json" sdk_components)
          string(JSON sdk_count LENGTH "${sdk_components}" components)
          math(EXPR sdk_last "${sdk_count}-1")
          foreach(sdk_index RANGE ${sdk_last})
            string(JSON sdk_component GET "${sdk_components}" components ${sdk_index})
            string(JSON component_count LENGTH "${components}" components)
            string(JSON components SET "${components}" components ${component_count} "${sdk_component}")
          endforeach()
        endif()
        file(WRITE "${stage}/meta/components.json" "${components}\n")
        set(INVENTORY_HAS_SDK FALSE)
        if(bundle STREQUAL "sdk")
          set(INVENTORY_HAS_SDK TRUE)
        endif()
        validate_components("${stage}" "meta/components.json")
      endif()
      quote_json(qbuild "${build_id}")
      file(WRITE "${stage}/meta/requirements.json" "{\"schema\":\"torch.requirements.v1\",\"libtorch_version\":\"${torch_version}\",\"build_id\":${qbuild},\"bundle\":\"${bundle}\",\"native_adapter\":\"${native_mode}\"}\n")
      file(WRITE "${stage}/sputnik.toml" "${common}\n[files]\ninclude = ${pack}\n${requirements}${providers}${native}")
      set(artifact "${OUTPUT}/torch-${PACKAGE_VERSION}-${variant}.sputnikpkg")
      set(report "${OUTPUT}/${variant}.json")
      execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg build "${stage}" --modules "${module_mode}" --out "${artifact}"
        OUTPUT_FILE "${report}" COMMAND_ERROR_IS_FATAL ANY)
      file(READ "${report}" info)
      string(JSON info SET "${info}" module_mode "\"${module_mode}\"")
      string(JSON rows SET "${rows}" ${row} "${info}")
      math(EXPR row "${row} + 1")
      string(JSON bytes GET "${info}" compressed_size)
      message(STATUS "${variant}: ${bytes} compressed bytes")
    endforeach()
  endforeach()
endforeach()
file(WRITE "${OUTPUT}/report.json" "{\"schema\":\"torch.packages.v1\",\"libtorch_version\":\"${torch_version}\",\"packages\":${rows},\"providers\":${provider_rows}}\n")
include("${ROOT}/cmake/PackageReport.cmake")
message(STATUS "Package matrix complete: ${OUTPUT}/report.json")
