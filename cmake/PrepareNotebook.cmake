function(prepare_notebook_bundle)
  set(directory "${build}/notebook")
  file(MAKE_DIRECTORY "${directory}")
  file(LOCK "${directory}/prepare.lock" GUARD FUNCTION TIMEOUT 0)
  set(registry "${directory}/projects.json")
  set(projects ${NOTEBOOK_PROJECTS})
  file(GLOB registrations "${directory}/projects/*.json")
  foreach(registration IN LISTS registrations)
    file(READ "${registration}" record)
    string(JSON project GET "${record}" path)
    if(EXISTS "${project}/project.json")
      list(APPEND projects "${project}")
    endif()
  endforeach()
  if(EXISTS "${registry}")
    file(READ "${registry}" registered)
    string(JSON count LENGTH "${registered}")
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(i RANGE ${last})
        string(JSON project GET "${registered}" ${i})
        if(EXISTS "${project}/project.json")
          list(APPEND projects "${project}")
        else()
          message(WARNING "Registered notebook was removed: ${project}")
        endif()
      endforeach()
    endif()
  endif()
  set(canonical_projects)
  foreach(project IN LISTS projects)
    file(REAL_PATH "${project}" project)
    run("${SPUTNIK_ROOT}/build/isputnik" --project-info "${project}")
    list(APPEND canonical_projects "${project}")
  endforeach()
  list(REMOVE_DUPLICATES canonical_projects)
  list(SORT canonical_projects)

  file(GLOB_RECURSE package_sources "${ROOT}/src/*.s" "${ROOT}/src/*.spu" "${ROOT}/src/*.sputnik"
    "${ROOT}/examples/mnist/*.s" "${ROOT}/examples/mnist/*.spu" "${ROOT}/examples/mnist/*.sputnik")
  file(GLOB_RECURSE cpp_sources "${ROOT}/native/*.cpp")
  file(GLOB_RECURSE cpp_headers "${ROOT}/native/*.h" "${SPUTNIK_ROOT}/runtime/*.h")
  set(prepared_extension "${extension}")
  json_array(values ${cpp_sources})
  string(JSON prepared_extension SET "${prepared_extension}" sources "${values}")
  file(GLOB_RECURSE package_headers "${ROOT}/native/*.h")
  json_array(values ${package_headers} "${build}/native-lock.json")
  string(JSON prepared_extension SET "${prepared_extension}" headers "${values}")
  set(inputs ${package_sources} ${cpp_sources} ${cpp_headers} "${ROOT}/tools/notebook_abi.cpp"
    "${ROOT}/CMakeLists.txt" "${ROOT}/cmake/PrepareNotebook.cmake" "${ROOT}/cmake/BuildJson.cmake" "${ROOT}/cmake/TorchProvider.cmake" "${build}/native-lock.json")
  list(SORT inputs)
  set(input_hashes "{}")
  foreach(input IN LISTS inputs)
    file(SHA256 "${input}" digest)
    quote_json(quoted "${digest}")
    string(JSON input_hashes SET "${input_hashes}" "${input}" "${quoted}")
  endforeach()
  string(SHA256 fingerprint "${input_hashes}\n${prepared_extension}")
  set(bundle "${directory}/${fingerprint}")
  set(library "${bundle}/libtorch_notebook.so")
  set(prepared_manifest "${bundle}/sputnik.build.json")
  if(NOT EXISTS "${bundle}/artifact.json")
    # Use a separate build tree: never overwrite a library already mapped by a worker.
    run(cmake -S "${ROOT}" -B "${build}/notebook-native" -G Ninja "-DCMAKE_PREFIX_PATH=${TORCH_PREFIX}"
      "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}" "-DGLOO_INCLUDE_DIR=${gloo}" ${provider_options} -DCMAKE_BUILD_TYPE=Release)
    run(cmake --build "${build}/notebook-native" --target torch_notebook -j 2)
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
    set(stage "${directory}/stage-${suffix}")
    file(MAKE_DIRECTORY "${stage}")
    set(prepared_modules "[]")
    set(index 0)
    foreach(source IN LISTS package_sources)
      file(RELATIVE_PATH relative "${ROOT}" "${source}")
      get_filename_component(parent "${stage}/${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(COPY_FILE "${source}" "${stage}/${relative}")
      file(SHA256 "${stage}/${relative}" copied_hash)
      string(JSON previous GET "${input_hashes}" "${source}")
      if(NOT copied_hash STREQUAL previous)
        message(FATAL_ERROR "Notebook source changed while copying: ${source}; retry")
      endif()
      file(STRINGS "${source}" declaration REGEX "^package[ \t]+" LIMIT_COUNT 1)
      string(REGEX REPLACE "^package[ \t]+" "" name "${declaration}")
      quote_json(qname "${name}")
      quote_json(qpath "${bundle}/${relative}")
      string(JSON prepared_modules SET "${prepared_modules}" ${index} "{\"name\":${qname},\"path\":${qpath}}")
      math(EXPR index "${index} + 1")
    endforeach()
    # Test entry-point oracles and headers do not belong to a notebook package.
    set(prepared "{\"schema\":\"sputnik.build.v1\",\"name\":\"torch\",\"root\":\"torch\",\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]}}")
    string(JSON prepared SET "${prepared}" modules "${prepared_modules}")
    string(JSON prepared SET "${prepared}" native_extensions "[${prepared_extension}]")
    file(WRITE "${stage}/sputnik.build.json" "${prepared}\n")
    file(COPY_FILE "${build}/notebook-native/libtorch_notebook.so" "${stage}/libtorch_notebook.so")
    file(SHA256 "${stage}/libtorch_notebook.so" native_hash)

    # Refuse to publish a mixed source/native generation if files changed during compilation.
    file(GLOB_RECURSE after_sources "${ROOT}/src/*.s" "${ROOT}/src/*.spu" "${ROOT}/src/*.sputnik"
      "${ROOT}/examples/mnist/*.s" "${ROOT}/examples/mnist/*.spu" "${ROOT}/examples/mnist/*.sputnik")
    file(GLOB_RECURSE after_cpp "${ROOT}/native/*.cpp")
    file(GLOB_RECURSE after_headers "${ROOT}/native/*.h" "${SPUTNIK_ROOT}/runtime/*.h")
    if(NOT after_sources STREQUAL package_sources OR NOT after_cpp STREQUAL cpp_sources OR NOT after_headers STREQUAL cpp_headers)
      message(FATAL_ERROR "Notebook package file set changed during preparation; retry")
    endif()
    foreach(input IN LISTS inputs)
      file(SHA256 "${input}" digest)
      string(JSON previous GET "${input_hashes}" "${input}")
      if(NOT digest STREQUAL previous)
        message(FATAL_ERROR "Notebook package input changed during preparation: ${input}; retry")
      endif()
    endforeach()
    quote_json(qhash "${native_hash}")
    file(SHA256 "${stage}/sputnik.build.json" manifest_hash)
    quote_json(qmanifest_hash "${manifest_hash}")
    file(WRITE "${stage}/artifact.json" "{\"native_sha256\":${qhash},\"manifest_sha256\":${qmanifest_hash},\"inputs\":${input_hashes}}\n")
    file(RENAME "${stage}" "${bundle}")
  endif()
  file(READ "${bundle}/artifact.json" artifact)
  string(JSON expected_hash GET "${artifact}" native_sha256)
  file(SHA256 "${library}" native_hash)
  if(NOT native_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Prepared notebook library changed: ${library}")
  endif()
  file(SHA256 "${prepared_manifest}" manifest_hash)
  string(JSON expected_hash GET "${artifact}" manifest_sha256)
  if(NOT manifest_hash STREQUAL expected_hash)
    message(FATAL_ERROR "Prepared notebook manifest changed: ${prepared_manifest}")
  endif()
  foreach(source IN LISTS package_sources)
    file(RELATIVE_PATH relative "${ROOT}" "${source}")
    file(SHA256 "${bundle}/${relative}" copied_hash)
    string(JSON expected_hash GET "${input_hashes}" "${source}")
    if(NOT copied_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Prepared notebook source changed: ${bundle}/${relative}")
    endif()
  endforeach()
  file(RELATIVE_PATH manifest_relative "${ROOT}" "${prepared_manifest}")
  file(RELATIVE_PATH library_relative "${ROOT}" "${library}")
  quote_json(qroot "${ROOT}")
  quote_json(qmanifest "${manifest_relative}")
  quote_json(qlibrary "${library_relative}")
  quote_json(qhash "${native_hash}")
  set(current "{\"path\":${qroot},\"auto_import\":false,\"manifest\":${qmanifest},\"native_library\":${qlibrary},\"native_sha256\":${qhash}}")
  file(WRITE "${directory}/current.json.tmp" "${current}\n")
  file(RENAME "${directory}/current.json.tmp" "${directory}/current.json")
  foreach(project IN LISTS canonical_projects)
    run("${SPUTNIK_ROOT}/build/isputnik" --update-native-dependency "${project}" "${ROOT}"
      "${manifest_relative}" "${library_relative}")
  endforeach()
  json_array(registered ${canonical_projects})
  file(WRITE "${registry}.tmp" "${registered}\n")
  file(RENAME "${registry}.tmp" "${registry}")
  message(STATUS "Prepared coherent notebook bundle: ${bundle}")
endfunction()
