include_guard(GLOBAL)

# Inspect C++ headers and shared libraries only. In particular, a ROCm provider
# may live beside language bindings without making those bindings a dependency.
function(torch_provider prefix)
  set(header "${prefix}/include/torch/csrc/api/include/torch/version.h")
  file(READ "${header}" version_header)
  if(version_header MATCHES "torch/headeronly/version.h")
    file(READ "${prefix}/include/torch/headeronly/version.h" version_header)
  endif()
  string(REPLACE "\\\n" "" version_header "${version_header}")
  string(REGEX MATCH "#define[ \t]+TORCH_VERSION[ \t]+\"([^\"]+)\"" match "${version_header}")
  set(version "${CMAKE_MATCH_1}")
  if(NOT version STREQUAL "2.14.0" AND NOT version STREQUAL "2.14.1")
    message(FATAL_ERROR "Adapter/Gloo headers require LibTorch 2.14.0 or 2.14.1; found '${version}'")
  endif()
  set(names torch torch_cpu c10)
  set(backend cpu)
  set(defines)
  if(EXISTS "${prefix}/lib/libtorch_hip.so")
    list(APPEND names torch_hip c10_hip)
    set(backend rocm)
    # CUDAHooksInterface has ROCm-only virtual members. Omitting USE_ROCM
    # changes its vtable layout even when no HIP kernels are compiled here.
    list(APPEND defines USE_ROCM=1 __HIP_PLATFORM_AMD__=1)
  elseif(EXISTS "${prefix}/lib/libtorch_cuda.so")
    list(APPEND names torch_cuda c10_cuda)
    set(backend cuda)
  endif()
  set(libraries)
  foreach(name IN LISTS names)
    set(library "${prefix}/lib/lib${name}.so")
    if(NOT EXISTS "${library}")
      message(FATAL_ERROR "Missing ${backend} LibTorch C++ library: ${library}")
    endif()
    list(APPEND libraries "${library}")
  endforeach()
  # Current supported Linux distributions use the C++11 ABI. Honor an explicit
  # upstream flag where one is recorded, including providers built with ABI 0.
  set(abi 1)
  file(READ "${prefix}/share/cmake/Torch/TorchConfig.cmake" config)
  if(config MATCHES "_GLIBCXX_USE_CXX11_ABI=([01])")
    set(abi "${CMAKE_MATCH_1}")
  endif()
  set(TORCH_PROVIDER_VERSION "${version}" PARENT_SCOPE)
  set(TORCH_PROVIDER_BACKEND "${backend}" PARENT_SCOPE)
  set(TORCH_PROVIDER_NAMES "${names}" PARENT_SCOPE)
  set(TORCH_PROVIDER_LIBRARIES "${libraries}" PARENT_SCOPE)
  set(TORCH_PROVIDER_ABI "${abi}" PARENT_SCOPE)
  set(TORCH_PROVIDER_DEFINES "${defines}" PARENT_SCOPE)
endfunction()
