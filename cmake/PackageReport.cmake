file(READ "${OUTPUT}/report.json" matrix)
string(JSON count LENGTH "${matrix}" packages)
string(JSON torch GET "${matrix}" libtorch_version)
set(text "# torch: package build results\n\nLibTorch ${torch}; Sputnik package/native ABI v1. ${count} requested artifacts.\n\nThe bundle axis is independent of Sputnik module representation and native adapter representation. Thin (`none`) packages contain no third-party runtime or SDK. `runtime` bundles include the required CPU/MPS dependency closure; `sdk` adds compiler-observed LibTorch and pinned Gloo headers. The host C++ compiler and platform SDK are external.\n\n")
string(APPEND text "| Native adapter | Bundle | Sputnik modules | Archive MiB | Expanded MiB | Files |\n|---|---|---|---:|---:|---:|\n")
math(EXPR last "${count}-1")
set(hashes "")
foreach(index RANGE ${last})
  foreach(field variant version name bundle native_adapter module_mode compressed_size expanded_size sha256)
    string(JSON ${field} GET "${matrix}" packages ${index} ${field})
  endforeach()
  string(JSON files LENGTH "${matrix}" packages ${index} members)
  foreach(field compressed_size expanded_size)
    math(EXPR hundredths "(${${field}}*100+524288)/1048576")
    math(EXPR whole "${hundredths}/100")
    math(EXPR fraction "${hundredths}%100")
    if(fraction LESS 10)
      set(fraction "0${fraction}")
    endif()
    set(${field}_mib "${whole}.${fraction}")
  endforeach()
  get_filename_component(local_name "${name}" NAME)
  set(artifact "${local_name}-${version}-${variant}.sputnikpkg")
  string(APPEND text "| ${native_adapter} | ${bundle} | [${module_mode}](${artifact}) | ${compressed_size_mib} | ${expanded_size_mib} | ${files} |\n")
  string(APPEND hashes "- `${artifact}`: `${sha256}`\n")
endforeach()
string(JSON provider_count LENGTH "${matrix}" providers)
if(provider_count GREATER 0)
  string(APPEND text "\n## Separate local providers\n\n")
  math(EXPR provider_last "${provider_count}-1")
  foreach(index RANGE ${provider_last})
    foreach(field name version variant compressed_size)
      string(JSON ${field} GET "${matrix}" providers ${index} ${field})
    endforeach()
    string(APPEND text "- [${name}](${name}-${version}-${variant}.sputnikpkg): ${compressed_size} bytes.\n")
  endforeach()
  string(APPEND text "\nThin source needs both providers; source+runtime needs only the SDK provider; thin prebuilt needs only runtime. Bind extracted provider directories explicitly with `SPUTNIK_NATIVE_PROVIDERS` (colon-separated). Runtime bundles are packaged relative to their loader paths and are prepared against a single canonical provider root.\n")
endif()
string(APPEND text "\nCPU and actual MPS share one macOS target. CUDA is unavailable here. Minimum macOS and architecture are recorded per artifact. SDK headers describe this adapter/target, not a universal SDK. Component/license materials accompany bundles and providers; these local development artifacts are not a legal clearance or publisher-signed release.\n\n")
file(SHA256 "${OUTPUT}/report.json" current_digest)
set(verified FALSE)
if(EXISTS "${OUTPUT}/verification/result.json")
  file(READ "${OUTPUT}/verification/result.json" verification)
  string(JSON verified_digest ERROR_VARIABLE error GET "${verification}" matrix_sha256)
  if(NOT error AND verified_digest STREQUAL current_digest)
    set(verified TRUE)
  endif()
endif()
if(verified)
  string(APPEND text "Verification: all ${count} extracted variants passed actual CPU/MPS forward/backward without MPS fallback. Prebuilt VM runs used an unavailable C++ compiler and no SDK binding. Each native/bundle combination also passed a bytecode consumer built with --require-full-native. Negative provider/SDK/cache tests and slim packaging without dependency probes passed. See verification/result.json.\n\n")
else()
  string(APPEND text "Verification: pending; run tools/test-packages for this exact matrix.\n\n")
endif()
string(APPEND text "Archives are ordinary tar.gz v1 and support the SDK shared installer, registry variant selection and exact locks. Thin source installation requires --build-from-source and matching external providers; prebuilt runtime installation needs no SDK or compiler.\n\n## SHA-256\n\n${hashes}")
file(WRITE "${OUTPUT}/REPORT.md" "${text}")
