cmake_minimum_required(VERSION 3.27)
include("${ROOT}/cmake/BuildJson.cmake")
include("${ROOT}/cmake/PackageManifest.cmake")
include("${ROOT}/cmake/TorchProvider.cmake")
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "Local ROCm packages require a Linux C++ provider")
endif()
file(REAL_PATH "${ROOT}" ROOT)
file(REAL_PATH "${TORCH_PREFIX}" TORCH_PREFIX)
file(REAL_PATH "${SPUTNIK_ROOT}" SPUTNIK_ROOT)
torch_provider("${TORCH_PREFIX}")
if(NOT TORCH_PROVIDER_BACKEND STREQUAL "rocm")
  message(FATAL_ERROR "Expected libtorch_hip.so and libc10_hip.so")
endif()
if(NOT OUTPUT)
  set(OUTPUT "${ROOT}/build/rocm-local-package")
endif()
if(NOT PACKAGE_VERSION)
  set(PACKAGE_VERSION "0.1.3-rocm-local")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(LOCK "${OUTPUT}/package.lock" GUARD PROCESS TIMEOUT 0)
set(build "${ROOT}/build/rocm-package-native")
set(options)
if(DEFINED ENV{SPUTNIK_NATIVE_CXX} AND NOT "$ENV{SPUTNIK_NATIVE_CXX}" STREQUAL "")
  list(APPEND options "-DCMAKE_CXX_COMPILER=$ENV{SPUTNIK_NATIVE_CXX}")
endif()
run(cmake -S "${ROOT}" -B "${build}" -G Ninja "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}"
  "-DSPUTNIKTORCH_PREBUILT_TORCH_ROOT=${TORCH_PREFIX}"
  "-DGLOO_INCLUDE_DIR=${ROOT}/build/deps/gloo-74cc005ae13f69c11d8a41e50b42025b6730e796"
  ${options} -DCMAKE_BUILD_TYPE=Release)
run(cmake --build "${build}" --target torch_notebook torch_probe -j 6)
run("${build}/torch_probe" cuda:0)
set(stage "${OUTPUT}/stage")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/lib" "${stage}/meta")
file(COPY "${ROOT}/src" DESTINATION "${stage}")
file(COPY_FILE "${build}/libtorch_notebook.so" "${stage}/lib/libtorch_notebook.so")
package_inventory(module_files module_names "${stage}")
file(SHA256 "${TORCH_PREFIX}/lib/libtorch_hip.so" provider_hash)
quote_json(qprefix "${TORCH_PREFIX}")
file(WRITE "${stage}/meta/local-provider.json" "{\"libtorch_version\":\"${TORCH_PROVIDER_VERSION}\",\"backend\":\"rocm\",\"prefix\":${qprefix},\"libtorch_hip_sha256\":\"${provider_hash}\",\"relocatable\":false}\n")
file(WRITE "${stage}/README.md" "Local ROCm adapter for the recorded host LibTorch C++ provider. Provider and ROCm libraries are external, not bundled. This package is not relocatable and is not a registry release.\n")
set(manifest "{\"name\":\"torch\",\"version\":\"${PACKAGE_VERSION}\",\"source_root\":\"src\",\"module_names\":${module_names},\"files\":${module_files},\"target\":{\"os\":\"linux\",\"arch\":\"x86_64\",\"libc\":\"gnu\"},\"profiles\":{\"required\":[\"core.v1\",\"ffi.v1\"]},\"native_extensions\":[{\"name\":\"torch\",\"kind\":\"prebuilt\",\"library\":\"lib/libtorch_notebook.so\",\"sputnik_ext_abi\":1}]}")
package_manifest_write("${stage}" "${manifest}" "lib/libtorch_notebook.so" "meta/local-provider.json" "README.md")
set(artifact "${OUTPUT}/torch-${PACKAGE_VERSION}.sputnikpkg")
execute_process(COMMAND "${SPUTNIK_ROOT}/build/sputnik" pkg build "${stage}" --modules source --out "${artifact}" OUTPUT_FILE "${OUTPUT}/report.json" COMMAND_ERROR_IS_FATAL ANY)
set(consumer "${OUTPUT}/consumer")
file(MAKE_DIRECTORY "${consumer}")
file(COPY_FILE "${ROOT}/tests/rocm_package_check.s" "${consumer}/check.s")
run(cmake -E env "SPUTNIK_PKG_HOME=${OUTPUT}/installed-home" "SPUTNIK_NATIVE_CXX=/compiler-must-not-run"
  "${SPUTNIK_ROOT}/build/sputnik" pkg install "${artifact}" --allow-native)
run(cmake -E env "SPUTNIK_PKG_HOME=${OUTPUT}/installed-home" "SPUTNIK_NATIVE_CXX=/compiler-must-not-run"
  "${SPUTNIK_ROOT}/build/sputnik" pkg lock "${consumer}/check.s")
run(cmake -E env "SPUTNIK_PKG_HOME=${OUTPUT}/installed-home" "SPUTNIK_NATIVE_CXX=/compiler-must-not-run"
  "${SPUTNIK_ROOT}/build/sputnik" run "${consumer}/check.s" --grant ffi)
execute_process(COMMAND cmake -E env "SPUTNIK_PKG_HOME=${OUTPUT}/installed-home"
  "${SPUTNIK_ROOT}/build/sputnik" build "${consumer}/check.s" --target native --require-full-native --grant ffi -o "${consumer}/native-check"
  OUTPUT_FILE "${OUTPUT}/native-build.json" COMMAND_ERROR_IS_FATAL ANY)
run(cmake -E env "SPUTNIK_NATIVE_CXX=/compiler-must-not-run" "${consumer}/native-check")
message(STATUS "Verified local ROCm package: ${artifact}")
