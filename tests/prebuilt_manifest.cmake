cmake_minimum_required(VERSION 3.27)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/BuildJson.cmake")
if(NOT MANIFEST OR NOT LIBRARY)
  message(FATAL_ERROR "Pass MANIFEST and LIBRARY")
endif()
file(REAL_PATH "${LIBRARY}" LIBRARY)
file(SHA256 "${LIBRARY}" digest)
get_filename_component(directory "${MANIFEST}" DIRECTORY)
set(copy "${directory}/rocm-prebuilt/${digest}/libtorch_notebook.so")
get_filename_component(parent "${copy}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(COPY_FILE "${LIBRARY}" "${copy}" ONLY_IF_DIFFERENT)
file(READ "${MANIFEST}" manifest)
string(JSON extension GET "${manifest}" native_extensions 0)
foreach(key sources headers cxxflags defines include_dirs library_dirs runtime_library_dirs link_libraries)
  string(JSON extension REMOVE "${extension}" "${key}")
endforeach()
string(JSON extension SET "${extension}" kind "\"prebuilt\"")
quote_json(quoted_library "${copy}")
string(JSON extension SET "${extension}" library "${quoted_library}")
string(JSON extension SET "${extension}" sputnik_ext_abi 1)
string(JSON manifest SET "${manifest}" native_extensions "[${extension}]")
file(WRITE "${OUTPUT}" "${manifest}\n")
