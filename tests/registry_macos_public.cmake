cmake_minimum_required(VERSION 3.27)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(SPUTNIK_ROOT "${ROOT}/../sputnik-lang" ABSOLUTE)
if(NOT RELEASE_VERSION)
  set(RELEASE_VERSION "0.1.3")
endif()
set(cli "${SPUTNIK_ROOT}/build/sputnik")
foreach(required MPS_PACKAGES SOURCE_PACKAGES WORK)
  if(NOT ${required})
    message(FATAL_ERROR "Pass -D${required}=absolute-directory")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
function(run_logged label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    WORKING_DIRECTORY "${WORK}"
    OUTPUT_FILE "${WORK}/${label}.log" ERROR_FILE "${WORK}/${label}.error")
  if(NOT status EQUAL 0)
    file(READ "${WORK}/${label}.error" error)
    message(FATAL_ERROR "${label} failed: ${error}")
  endif()
  message(STATUS "PASS ${label}")
endfunction()
run_logged(metadata "${cli}" pkg variants torch@${RELEASE_VERSION} --json)
file(READ "${WORK}/metadata.log" release)
string(JSON count LENGTH "${release}" artifacts)
math(EXPR last "${count}-1")
foreach(kind mps source)
  if(kind STREQUAL "mps")
    set(directory "${MPS_PACKAGES}")
    set(bindings "")
    set(compiler /compiler-must-not-run)
    set(extra --bundle runtime --allow-native-large)
  else()
    set(directory "${SOURCE_PACKAGES}")
    set(bindings "${MPS_PACKAGES}/providers/runtime:${MPS_PACKAGES}/providers/sdk")
    set(compiler /usr/bin/clang++)
    set(extra --build-from-source)
  endif()
  file(READ "${directory}/report.json" report)
  string(JSON variant GET "${report}" packages 0 variant)
  string(JSON digest GET "${report}" packages 0 sha256)
  set(found FALSE)
  foreach(index RANGE ${last})
    string(JSON actual_variant GET "${release}" artifacts ${index} variant)
    if(actual_variant STREQUAL variant)
      string(JSON actual_digest GET "${release}" artifacts ${index} sha256)
      if(NOT actual_digest STREQUAL digest)
        message(FATAL_ERROR "Public artifact digest differs from local verification")
      endif()
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "Public registry lacks ${variant}")
  endif()
  set(home "${WORK}/${kind}-home")
  set(consumer "${WORK}/${kind}-consumer")
  file(MAKE_DIRECTORY "${consumer}")
  file(COPY_FILE "${ROOT}/tests/registry_mps_check.s" "${consumer}/check.s")
  set(environment PYTORCH_ENABLE_MPS_FALLBACK=0 "SPUTNIK_PKG_HOME=${home}"
    "SPUTNIK_NATIVE_PROVIDERS=${bindings}" "SPUTNIK_NATIVE_CXX=${compiler}")
  run_logged("${kind}-install" "${CMAKE_COMMAND}" -E env ${environment} "${cli}" pkg install
    torch --version "${RELEASE_VERSION}" --backend mps --allow-native ${extra})
  run_logged("${kind}-lock" "${CMAKE_COMMAND}" -E env ${environment}
    "${cli}" pkg lock "${consumer}/check.s" --backend mps)
  file(READ "${consumer}/sputnik.lock" lock)
  if(NOT lock MATCHES "${digest}" OR NOT lock MATCHES "${variant}" OR
     NOT lock MATCHES "source = \"https://registry.sputnik-lang.online\"")
    message(FATAL_ERROR "Public install lock lacks exact variant/hash/origin")
  endif()
  run_logged("${kind}-vm" "${CMAKE_COMMAND}" -E env ${environment}
    "${cli}" run "${consumer}/check.s" --grant ffi)
endforeach()
file(WRITE "${WORK}/result.json"
  "{\"schema\":\"torch.registry-macos-public-verification.v1\",\"version\":\"${RELEASE_VERSION}\",\"registry\":\"https://registry.sputnik-lang.online\",\"mps\":true,\"source\":true,\"public_digest_verified\":true,\"locked_origin_verified\":true,\"mps_fallback\":false}\n")
