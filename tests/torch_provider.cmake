cmake_minimum_required(VERSION 3.27)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${root}/cmake/TorchProvider.cmake")
if(CHECK_PREFIX)
  torch_provider("${CHECK_PREFIX}")
  return()
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(fixture "${root}/build/provider-test-${suffix}")
file(MAKE_DIRECTORY "${fixture}/include/torch/csrc/api/include/torch" "${fixture}/include/torch/headeronly" "${fixture}/share/cmake/Torch" "${fixture}/lib")
file(WRITE "${fixture}/include/torch/csrc/api/include/torch/version.h" "#include <torch/headeronly/version.h>\n")
file(WRITE "${fixture}/include/torch/headeronly/version.h" "#define TORCH_VERSION \"2.14.0\"\n")
file(WRITE "${fixture}/share/cmake/Torch/TorchConfig.cmake" "set(TORCH_CXX_FLAGS \"-D_GLIBCXX_USE_CXX11_ABI=0\")\n")
foreach(name torch torch_cpu c10)
  file(WRITE "${fixture}/lib/lib${name}.so" "fixture")
endforeach()
torch_provider("${fixture}")
if(NOT TORCH_PROVIDER_BACKEND STREQUAL "cpu" OR NOT TORCH_PROVIDER_ABI STREQUAL "0")
  message(FATAL_ERROR "CPU provider or explicit ABI was not preserved")
endif()
foreach(name torch_cuda c10_cuda)
  file(WRITE "${fixture}/lib/lib${name}.so" "fixture")
endforeach()
torch_provider("${fixture}")
if(NOT TORCH_PROVIDER_BACKEND STREQUAL "cuda" OR NOT "torch_cuda" IN_LIST TORCH_PROVIDER_NAMES)
  message(FATAL_ERROR "CUDA provider was not linked")
endif()
file(REMOVE "${fixture}/lib/libtorch_cuda.so" "${fixture}/lib/libc10_cuda.so")
foreach(name torch_hip c10_hip)
  file(WRITE "${fixture}/lib/lib${name}.so" "fixture")
endforeach()
torch_provider("${fixture}")
if(NOT TORCH_PROVIDER_BACKEND STREQUAL "rocm" OR NOT "torch_hip" IN_LIST TORCH_PROVIDER_NAMES OR "torch_cuda" IN_LIST TORCH_PROVIDER_NAMES)
  message(FATAL_ERROR "ROCm provider must link HIP libraries")
endif()
file(REMOVE "${fixture}/lib/libc10_hip.so")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DCHECK_PREFIX=${fixture}" -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Missing rocm LibTorch C[+][+] library")
  message(FATAL_ERROR "Incomplete HIP provider was accepted: ${output}${error}")
endif()
file(REMOVE_RECURSE "${fixture}")
message(STATUS "PASS CPU/CUDA/ROCm C++ providers, ABI and missing HIP library")
