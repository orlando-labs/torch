cmake_minimum_required(VERSION 3.27)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${ROOT}/cmake/ValidateComponents.cmake")
if(NOT WORK)
  set(WORK "${ROOT}/build/package-component-tests")
endif()
if(NOT CASE)
  foreach(case valid missing-material missing-mapping)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DCASE=${case}" "-DWORK=${WORK}/${case}"
      -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
    if(case STREQUAL "valid")
      if(NOT status EQUAL 0)
        message(FATAL_ERROR "Valid component inventory rejected")
      endif()
    elseif(status EQUAL 0)
      message(FATAL_ERROR "Invalid component inventory accepted: ${case}")
    endif()
  endforeach()
  message(STATUS "Component inventory positive/negative tests passed")
  return()
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/lib/vendor" "${WORK}/meta" "${WORK}/licenses")
file(WRITE "${WORK}/lib/vendor/library.dylib" "fixture")
file(WRITE "${WORK}/licenses/LICENSE" "fixture license")
file(WRITE "${WORK}/meta/components.json" "{\"schema\":\"sputnik.native-components.v1\",\"components\":[{\"name\":\"fixture\",\"version\":\"1\",\"license\":\"MIT\",\"origin\":\"fixture\",\"files\":[\"lib/vendor/library.dylib\"],\"materials\":[\"licenses/LICENSE\"]}]}")
if(CASE STREQUAL "missing-material")
  file(REMOVE "${WORK}/licenses/LICENSE")
elseif(CASE STREQUAL "missing-mapping")
  file(WRITE "${WORK}/lib/vendor/undeclared.dylib" "fixture")
endif()
validate_components("${WORK}" "meta/components.json")
