cmake_minimum_required(VERSION 3.27)
get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(SPUTNIK_ROOT "${ROOT}/../sputnik-lang" ABSOLUTE)
if(NOT RELEASE_VERSION)
  set(RELEASE_VERSION "0.1.3")
endif()
set(cli "${SPUTNIK_ROOT}/build/sputnik")
foreach(required MPS_PACKAGES SOURCE_PACKAGES WORK)
  if(NOT ${required})
    message(FATAL_ERROR "Pass -D${required}=absolute-directory")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
file(READ "${MPS_PACKAGES}/report.json" mps_report)
file(READ "${SOURCE_PACKAGES}/report.json" source_report)
string(JSON mps_digest GET "${mps_report}" packages 0 sha256)
string(JSON source_digest GET "${source_report}" packages 0 sha256)
if(RESUME_SOURCE)
  file(READ "${WORK}/mps-native.log" previous_mps)
  file(READ "${WORK}/mps-consumer/sputnik.lock" previous_lock)
  if(NOT previous_mps MATCHES "PASS CPU/MPS LibTorch 2.14.0" OR
     NOT previous_lock MATCHES "${mps_digest}")
    message(FATAL_ERROR "Resume requires the successful MPS check of this exact archive")
  endif()
endif()
set(bindings "${MPS_PACKAGES}/providers/runtime:${MPS_PACKAGES}/providers/sdk")
function(run_logged label)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE status
    OUTPUT_FILE "${WORK}/${label}.log" ERROR_FILE "${WORK}/${label}.error")
  if(NOT status EQUAL 0)
    file(READ "${WORK}/${label}.error" error)
    message(FATAL_ERROR "${label} failed: ${error}")
  endif()
  message(STATUS "PASS ${label}")
endfunction()
foreach(kind mps source)
  if(RESUME_SOURCE AND kind STREQUAL "mps")
    continue()
  endif()
  set(report "${${kind}_report}")
  foreach(field variant name version sha256 native_adapter bundle)
    string(JSON ${field} GET "${report}" packages 0 ${field})
  endforeach()
  if(NOT name STREQUAL "slowpilot/torch" OR NOT version STREQUAL "${RELEASE_VERSION}")
    message(FATAL_ERROR "Unexpected publication identity")
  endif()
  if(kind STREQUAL "mps")
    set(directory "${MPS_PACKAGES}")
    set(provider_environment "")
    set(extra --allow-native-large --backend mps --bundle runtime)
    set(compiler /compiler-must-not-run)
  else()
    set(directory "${SOURCE_PACKAGES}")
    set(provider_environment "${bindings}")
    set(extra --build-from-source --backend mps)
    set(compiler /usr/bin/clang++)
    if(NOT bundle STREQUAL "none" OR NOT native_adapter STREQUAL "source")
      message(FATAL_ERROR "Thin source includes a runtime or SDK")
    endif()
    string(JSON count LENGTH "${report}" packages 0 members)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      string(JSON member GET "${report}" packages 0 members ${index} path)
      if(member MATCHES "^(lib/|sdk/)")
        message(FATAL_ERROR "Thin source includes dependency asset ${member}")
      endif()
    endforeach()
  endif()
  set(artifact "${directory}/torch-${version}-${variant}.sputnikpkg")
  file(SHA256 "${artifact}" actual)
  if(NOT sha256 STREQUAL "sha256:${actual}")
    message(FATAL_ERROR "Artifact report mismatch")
  endif()
  set(home "${WORK}/${kind}-home")
  set(consumer "${WORK}/${kind}-consumer")
  file(MAKE_DIRECTORY "${consumer}")
  file(COPY_FILE "${ROOT}/tests/registry_mps_check.s" "${consumer}/check.s")
  if(kind STREQUAL "source")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
      "SPUTNIK_PKG_HOME=${WORK}/missing-providers" SPUTNIK_NATIVE_PROVIDERS=
      SPUTNIK_NATIVE_CXX=/compiler-must-not-run "${cli}" pkg install "${artifact}"
      --allow-native --build-from-source RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "missing native provider")
      message(FATAL_ERROR "Missing dependencies were not rejected before compilation: ${error}")
    endif()
    file(READ "${MPS_PACKAGES}/providers/runtime/sputnik.build.json" wrong)
    string(REPLACE "\"version\":\"2.14.0\"" "\"version\":\"2.11.0\"" wrong "${wrong}")
    file(MAKE_DIRECTORY "${WORK}/wrong-runtime")
    file(WRITE "${WORK}/wrong-runtime/sputnik.build.json" "${wrong}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
      "SPUTNIK_PKG_HOME=${WORK}/wrong-version" "SPUTNIK_NATIVE_PROVIDERS=${WORK}/wrong-runtime:${MPS_PACKAGES}/providers/sdk"
      SPUTNIK_NATIVE_CXX=/compiler-must-not-run "${cli}" pkg install "${artifact}"
      --allow-native --build-from-source RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE error)
    if(status EQUAL 0 OR NOT error MATCHES "NATIVE_ABI_CONFLICT")
      message(FATAL_ERROR "Wrong LibTorch version was not rejected: ${error}")
    endif()
    message(STATUS "PASS source missing/wrong dependencies rejected")
  endif()
  if(NOT RESUME_SOURCE)
    run_logged("${kind}-install" "${CMAKE_COMMAND}" -E env
      PYTORCH_ENABLE_MPS_FALLBACK=0 "SPUTNIK_PKG_HOME=${home}"
      "SPUTNIK_NATIVE_PROVIDERS=${provider_environment}" "SPUTNIK_NATIVE_CXX=${compiler}"
      "${cli}" pkg install "${artifact}" --allow-native ${extra})
  elseif(NOT EXISTS "${home}/slowpilot/torch/${version}/${variant}/native-library.meta")
    message(FATAL_ERROR "Resume requires the completed source installation")
  endif()
  run_logged("${kind}-lock" "${CMAKE_COMMAND}" -E env "SPUTNIK_PKG_HOME=${home}"
    "${cli}" pkg lock "${consumer}/check.s" --backend mps)
  file(READ "${consumer}/sputnik.lock" lock)
  if(NOT lock MATCHES "${variant}" OR NOT lock MATCHES "${actual}")
    message(FATAL_ERROR "Exact variant/hash missing from lock")
  endif()
  set(environment PYTORCH_ENABLE_MPS_FALLBACK=0 "SPUTNIK_PKG_HOME=${home}"
    "SPUTNIK_NATIVE_PROVIDERS=${provider_environment}" "SPUTNIK_NATIVE_CXX=${compiler}")
  run_logged("${kind}-vm" "${CMAKE_COMMAND}" -E env ${environment}
    "${cli}" run "${consumer}/check.s" --grant ffi)
  run_logged("${kind}-native-build" "${CMAKE_COMMAND}" -E env
    PYTORCH_ENABLE_MPS_FALLBACK=0 "SPUTNIK_PKG_HOME=${home}" "SPUTNIK_NATIVE_PROVIDERS=${provider_environment}"
    "${cli}" build "${consumer}/check.s" --target native --require-full-native --grant ffi
    -o "${consumer}/native-check")
  run_logged("${kind}-native" "${CMAKE_COMMAND}" -E env PYTORCH_ENABLE_MPS_FALLBACK=0
    SPUTNIK_NATIVE_PROVIDERS= SPUTNIK_NATIVE_CXX=/compiler-must-not-run "${consumer}/native-check")
endforeach()
file(WRITE "${WORK}/result.json"
  "{\"schema\":\"torch.registry-macos-verification.v1\",\"version\":\"${RELEASE_VERSION}\",\"mps_sha256\":\"${mps_digest}\",\"source_sha256\":\"${source_digest}\",\"cpu_mps\":true,\"mps_fallback\":false,\"vm\":true,\"full_native\":true,\"missing_provider_rejected\":true,\"wrong_libtorch_rejected\":true}\n")
