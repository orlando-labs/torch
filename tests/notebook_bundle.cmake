cmake_minimum_required(VERSION 3.27)
get_filename_component(package "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT SPUTNIK_ROOT)
  get_filename_component(SPUTNIK_ROOT "${package}/../sputnik-lang" ABSOLUTE)
endif()
function(run)
  execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()
include("${package}/cmake/BuildJson.cmake")
include("${package}/cmake/PrepareNotebook.cmake")
if(NOT FIXTURE)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
  set(FIXTURE "/tmp/torch-notebook-${suffix}")
endif()
set(ROOT "${FIXTURE}/package")
set(build "${ROOT}/build")
set(extension "{\"name\":\"torch\",\"language\":\"c++\"}")
if(CHECK_ONLY)
  prepare_notebook_bundle()
  return()
endif()
file(MAKE_DIRECTORY "${ROOT}/src" "${ROOT}/native" "${ROOT}/tools" "${ROOT}/cmake" "${build}")
file(WRITE "${ROOT}/src/torch.s" "package torch\nexport answer\ndef answer(): 42\n")
file(WRITE "${ROOT}/tools/notebook_abi.cpp" "// mock artifact\n")
file(WRITE "${build}/native-lock.json" "{}\n")
file(COPY_FILE "${package}/cmake/PrepareNotebook.cmake" "${ROOT}/cmake/PrepareNotebook.cmake")
file(COPY_FILE "${package}/cmake/BuildJson.cmake" "${ROOT}/cmake/BuildJson.cmake")
file(COPY_FILE "${package}/cmake/TorchProvider.cmake" "${ROOT}/cmake/TorchProvider.cmake")
file(WRITE "${ROOT}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.27)\nproject(Mock NONE)\nfile(WRITE \"\${CMAKE_BINARY_DIR}/libtorch_notebook.so\" \"mock native artifact\")\nadd_custom_target(torch_notebook)\n")
set(project "${FIXTURE}/Edited notebook.sputnikbook")
run("${SPUTNIK_ROOT}/build/isputnik" --new-project "${project}")
file(READ "${project}/project.json" document)
quote_json(qroot "${ROOT}")
string(JSON document SET "${document}" dependencies "[{\"path\":${qroot},\"auto_import\":true,\"manifest\":\"old.json\",\"native_library\":\"old.so\",\"native_sha256\":\"old\",\"custom\":{\"keep\":true}}]")
string(JSON document SET "${document}" version 3)
string(JSON document SET "${document}" inputs "[]")
string(JSON document SET "${document}" boards "[]")
file(WRITE "${project}/project.json" "${document}\n")
set(NOTEBOOK_PROJECTS "${project}")
prepare_notebook_bundle()
file(READ "${build}/notebook/current.json" first)
string(JSON old_manifest GET "${first}" manifest)
file(READ "${ROOT}/${old_manifest}" manifest)
string(JSON count LENGTH "${manifest}" modules)
if(NOT count EQUAL 1)
  message(FATAL_ERROR "Expected only production modules")
endif()
string(JSON old_source GET "${manifest}" modules 0 path)
file(READ "${old_source}" original)

# A new nested module must appear on the next ordinary registered-project refresh.
file(MAKE_DIRECTORY "${ROOT}/src/nn/utils")
file(WRITE "${ROOT}/src/nn/utils/packed_sequence.s" "package torch.nn.utils.packed_sequence\nexport value\ndef value(): 99\n")
file(WRITE "${ROOT}/src/torch.s" "package torch\nfrom torch.nn.utils.packed_sequence import value\nexport answer\ndef answer(): value()\n")
unset(NOTEBOOK_PROJECTS)
prepare_notebook_bundle()
file(READ "${build}/notebook/current.json" second)
string(JSON new_manifest GET "${second}" manifest)
if(new_manifest STREQUAL old_manifest)
  message(FATAL_ERROR "Source change did not create a new coherent bundle")
endif()
file(READ "${ROOT}/${new_manifest}" manifest)
string(JSON count LENGTH "${manifest}" modules)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Nested module was omitted")
endif()
file(READ "${old_source}" still_original)
if(NOT original STREQUAL still_original)
  message(FATAL_ERROR "Old bundle was overwritten")
endif()
file(READ "${project}/project.json" updated)
string(JSON linked_manifest GET "${updated}" dependencies 0 manifest)
string(JSON preserved GET "${updated}" dependencies 0 custom keep)
if(NOT linked_manifest STREQUAL new_manifest OR NOT preserved)
  message(FATAL_ERROR "Registered project was not updated, or metadata was lost")
endif()
prepare_notebook_bundle()
file(READ "${project}/project.json" unchanged)
if(NOT updated STREQUAL unchanged)
  message(FATAL_ERROR "Unchanged preparation rewrote the project")
endif()

# Tampering/failure must leave both the published generation and project unchanged.
string(JSON copied_source GET "${manifest}" modules 0 path)
file(WRITE "${copied_source}" "tampered snapshot\n")
execute_process(COMMAND cmake "-DFIXTURE=${FIXTURE}" "-DSPUTNIK_ROOT=${SPUTNIK_ROOT}"
  -DCHECK_ONLY=ON -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE rejected OUTPUT_QUIET ERROR_QUIET)
if(rejected EQUAL 0)
  message(FATAL_ERROR "Modified prepared source was accepted")
endif()
file(READ "${build}/notebook/current.json" after_failure)
file(READ "${project}/project.json" after_project)
if(NOT second STREQUAL after_failure OR NOT updated STREQUAL after_project)
  message(FATAL_ERROR "Failed preparation changed the published bundle/project")
endif()
file(REMOVE_RECURSE "${FIXTURE}")
message(STATUS "PASS notebook bundle snapshots, nested modules, registration, idempotence and failure preservation")
